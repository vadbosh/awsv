#!/usr/bin/env bash
#
# awsv — keep AWS access keys in a GPG-encrypted vault, not in ~/.aws/credentials.
#
# The user guide is built in: 'awsv help', or 'awsv help TOPIC' for one situation
# step by step. Its text is help_text() below — edit it there, not here.

set -uo pipefail
umask 077

AWSV_HOME="${AWSV_HOME:-$HOME/.local/share/awsv}"
# Cached STS sessions live on a private tmpfs, so a reboot clears them.
#   AWSV_RUN set            that directory; set it empty to turn the cache off
#   $XDG_RUNTIME_DIR/awsv   a normal user: /run/user/UID, private, made at login
#   /run/awsv               root without XDG_RUNTIME_DIR
#   none                    no private tmpfs: no cache, and every call asks STS
# A normal user cannot write to /run, so /run/awsv is for root only.
if [ -z "${AWSV_RUN+x}" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        AWSV_RUN="$XDG_RUNTIME_DIR/awsv"
    elif [ "$(id -u)" = 0 ]; then
        AWSV_RUN=/run/awsv
    else
        AWSV_RUN=""
    fi
fi
# Every cache path is built from this value, and a cache path is deleted with
# rm. An empty or relative value must never turn into a path under / .
case "$AWSV_RUN" in
    "") ;;
    /) printf 'awsv: AWSV_RUN cannot be /\n' >&2; exit 1 ;;
    /*) ;;
    *) printf 'awsv: AWSV_RUN must be an absolute path, not %s\n' "$AWSV_RUN" >&2; exit 1 ;;
esac
CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
CREDS="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
SESSION_SECONDS="${AWSV_SESSION_SECONDS:-3600}"
GPG_UID="awsv local vault"
SELF="$(readlink -f "$0")"
# The path written into ~/.aws/config. The installed copy, when there is one:
# a run straight from the repository must not tie the config to the work tree.
BIN="$(readlink -f "$(command -v awsv 2>/dev/null || echo "$SELF")")"
KEYS="$AWSV_HOME/keys"
META="$AWSV_HOME/meta"
BACKUP="$AWSV_HOME/backup"
BEGIN="# >>> awsv: generated, do not edit between these two lines >>>"
END="# <<< awsv <<<"

# Colour only on a terminal. "awsv creds" writes JSON for the AWS CLI to parse,
# and an escape code in it would break every call; NO_COLOR turns it off too.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' C=$'\e[36m' D=$'\e[2m' N=$'\e[0m'
else
    B="" G="" Y="" R="" C="" D="" N=""
fi
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    EB=$'\e[1m' ER=$'\e[31m' EY=$'\e[33m' EN=$'\e[0m'
else
    EB="" ER="" EY="" EN=""
fi

die()  { printf '%sawsv: %s%s\n' "$ER$EB" "$*" "$EN" >&2; exit 1; }
warn() { printf '%s%s%s\n' "$EY" "$*" "$EN" >&2; }
ok()   { printf '%s%s%s\n' "$G" "$*" "$N"; }
say()  { printf '%s\n' "$*"; }
help_text() {
cat <<'EOF'
awsv keeps AWS access keys in an encrypted vault, not in ~/.aws/credentials.
aws, Terraform and the SDKs get the keys through ~/.aws/config.
You type one passphrase, and the vault stays open for 8 hours.

  awsv help COMMAND    one command and its example
  awsv help            this page

START HERE
    $ ./install.sh                        # in the awsv repository: check the parts, install
    $ awsv init --take-default            # create the vault key and choose its passphrase
    $ awsv import default --as work       # move the current [default] key into the vault
    $ awsv status                         # "no keys left" means done

SEE A STORED KEY
  ! awsv show NAME
  ! The same with gpg: gpg --decrypt ~/.local/share/awsv/keys/NAME.gpg
  ! Both print the secret. Run them only in your own terminal.

COMMANDS
  init  add  import  ls  use  exec  set  rekey  rm  show  passwd  unlock  lock  status

FILES
  ~/.local/share/awsv/keys/NAME.gpg   the key of one account, encrypted
  ~/.local/share/awsv/meta/NAME       region, mode and account number; not secret
  ~/.local/share/awsv/active          the name of the [default] account
  ~/.local/share/awsv/backup/         copies made before each change
  ~/.aws/config                       awsv writes only between its two marker lines
  ~/.aws/credentials                  stays empty; do not put keys there

@ init | create the vault key; run it once
    $ awsv init                         # asks for a new passphrase, twice
    $ awsv init --take-default          # the same, when ~/.aws/config has its own [default]
  Then open a new terminal: init adds GPG_TTY to ~/.bashrc.

@ add | store a new account
    $ awsv add prod --region eu-central-1        # asks for the key id, then the secret (hidden)
    $ aws --profile prod sts get-caller-identity # check that it works
    $ awsv use prod                              # make it [default], if you want
  Type the key here. Do not put it into ~/.aws/credentials first.
  AWS checks the key before awsv stores it.

@ import | move a key from ~/.aws/credentials into the vault
    $ awsv import nexum                 # works for [nexum] and for a commented #[nexum]
    $ awsv import default --as work     # "default" is reserved, so give it a name
    $ awsv status                       # repeat imports until "no keys left"
  The section leaves the file. An encrypted copy of the file goes to backup/.

@ ls | list the accounts
    $ awsv ls                           # * marks [default]; then mode, region, account

@ use | change the [default] account
    $ awsv use nexum                    # plain "aws ..." now works as nexum
    $ aws s3 ls                         # runs as nexum
  This replaces commenting sections in and out.

@ exec | run one command as another account
    $ awsv exec nexum -- terraform plan # [default] does not change
    $ aws --profile nexum s3 ls         # the same for aws alone

@ set | change the region or the mode of an account
    $ awsv set nexum --region us-east-2
    $ awsv set work --mode direct       # tools get the key itself
    $ awsv set work --mode session      # tools get a one-hour session; the default
  Use direct for Terraform. A session made without MFA cannot call the IAM API.
  A session also needs the vault open again when it expires during a long run.

@ rekey | replace the key of an account
    $ awsv rekey work                   # type the new key from IAM; AWS checks it first
  Then deactivate the old key in IAM. AWS still accepts it.

@ rm | remove an account
    $ awsv rm old                       # asks you to confirm
    $ awsv use work                     # when old was [default]
  Then deactivate the key in IAM. Removal from the vault does not revoke it.

@ show | see a stored key
  ! awsv show work
  !   prints the key id and the secret
  !   the same with gpg: gpg --decrypt ~/.local/share/awsv/keys/work.gpg
  It asks for the passphrase when the vault is locked.
  It refuses in a pipe, a script or an assistant's shell, so the secret stays out of logs.

@ passwd | change the passphrase
    $ awsv passwd                       # the current passphrase, then the new one twice
  The files in keys/ do not change. The passphrase locks the vault key, not each file.

@ unlock | type the passphrase now
    $ awsv unlock                       # scripts and assistants can then use the vault
  "Error when retrieving credentials from custom-process" means: run awsv unlock.

@ lock | close the vault now
    $ awsv lock                         # forget the passphrase, delete the cached sessions

@ status | check the state
    $ awsv status
  [default]    the account that plain "aws" uses
  agent        unlocked: the passphrase is in memory, up to 8 hours
  session      cached one-hour sessions; only accounts in session mode have one
  plain text   "no keys left" is correct; a red WARNING means a key is still there
EOF
}

topics() { help_text | sed -n 's/^@ \([a-z]*\) |.*/\1/p' | tr '\n' ' '; }

# On a terminal: headings bold, commands coloured, warnings yellow.
# "@ command | what it does" opens a section; "    $ ..." is a line to type;
# "  ! ..." is a warning. With a TOPIC, only that section is printed.
render_help() {
    help_text | awk -v t="${1:-}" -v b="$B" -v c="$C" -v n="$N" -v d="$D" -v y="$Y" '
        /^@ / {
            h = substr($0, 3); i = index(h, " | ")
            sec = substr(h, 1, i - 1); title = substr(h, i + 3)
            show = (t == "" || t == sec); if (t == sec) found = 1
            if (show) { if (t == "") print ""; printf "%s%s — %s%s\n", b, sec, title, n }
            next
        }
        t != "" && sec == "" { next }       # with a topic, skip the general part
        sec != "" && !show { next }
        /^    \$ / {                         # a line to type; "  # why" after it is dimmed
            l = $0; sub(/^    \$ /, "", l); i = index(l, "  #")
            if (i) { cmd = substr(l, 1, i - 1); com = substr(l, i) } else { cmd = l; com = "" }
            printf "    %s%s%s%s%s%s\n", c, cmd, n, d, com, n; next
        }
        /^  ! / { l = $0; sub(/^  ! /, "", l); printf "  %s%s%s\n", y, l, n; next }   # a warning
        /^[A-Z][A-Z ]+$/ { printf "%s%s%s\n", b, $0, n; next }
        { print }
        END { if (t != "" && !found) exit 3 }'
}

cmd_help() {
    local topic="${1:-}"
    if [ -n "$topic" ]; then
        render_help "$topic" || die "no help topic '$topic' — topics: $(topics)"
    elif [ -t 1 ] && command -v less >/dev/null 2>&1; then
        render_help "" | less -RFX
    else
        render_help ""
    fi
}

# ---------------------------------------------------------------- helpers

valid_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] \
        || die "bad name '$1': use lowercase letters, digits, '-' and '_', up to 32"
    [ "$1" != default ] \
        || die "'default' is reserved: it is the account that 'awsv use' selected"
}
valid_region() { [[ "$1" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]] || die "bad region '$1'"; }
valid_mode()   { [ "$1" = session ] || [ "$1" = direct ] || die "mode is 'session' or 'direct', not '$1'"; }
exists()       { [ -f "$KEYS/$1.gpg" ]; }
need()         { exists "$1" || die "no account '$1' in the vault — see 'awsv ls'"; }
active()       { cat "$AWSV_HOME/active" 2>/dev/null; }

need_tty() {
    { [ -t 0 ] && [ -t 1 ]; } || die "$1 needs a terminal"
    GPG_TTY="$(tty)"; export GPG_TTY
}

fpr() {
    gpg --list-secret-keys --with-colons -- "$GPG_UID" 2>/dev/null \
        | awk -F: '/^fpr:/ {print $10; exit}'
}
grip() {   # keygrip of the encryption subkey: what gpg-agent caches
    gpg --list-secret-keys --with-colons --with-keygrip -- "$GPG_UID" 2>/dev/null \
        | awk -F: '/^ssb:/ {s=1} s && /^grp:/ {print $10; exit}'
}

meta_get() { sed -n "s/^$2=//p" "$META/$1" 2>/dev/null | head -1; }
meta_set() {
    local f="$META/$1"
    mkdir -p "$META"; touch "$f"
    if grep -q "^$2=" "$f"; then sed -i "s|^$2=.*|$2=$3|" "$f"
    else printf '%s=%s\n' "$2" "$3" >> "$f"; fi
}

# --------------------------------------------------------- the vault itself

encrypt_key() {   # NAME — AKID and SECRET are set
    local f; f="$(fpr)"
    [ -n "$f" ] || die "no GPG key yet — run 'awsv init' first"
    mkdir -p "$KEYS"
    # printf is a shell builtin: the secret never appears in a process argument list.
    printf 'AccessKeyId=%s\nSecretAccessKey=%s\n' "$AKID" "$SECRET" \
        | gpg --quiet --yes --trust-model always --encrypt --recipient "$f" \
              --output "$KEYS/$1.gpg.tmp" \
        || die "encryption failed"
    mv -f "$KEYS/$1.gpg.tmp" "$KEYS/$1.gpg"
}

decrypt_key() {   # NAME — sets AKID and SECRET
    local out errf why
    errf="$(mktemp)"
    if ! out="$(gpg --quiet --decrypt "$KEYS/$1.gpg" 2>"$errf" </dev/null)"; then
        why="$(grep -m1 -v '^gpg: encrypted with' "$errf")"; rm -f "$errf"
        die "cannot open '$1' — ${why:-gpg failed}. If the vault is locked, run 'awsv unlock' in a terminal."
    fi
    rm -f "$errf"
    AKID="$(printf '%s\n' "$out" | sed -n 's/^AccessKeyId=//p')"
    SECRET="$(printf '%s\n' "$out" | sed -n 's/^SecretAccessKey=//p')"
    [ -n "$AKID" ] && [ -n "$SECRET" ] || die "the vault entry '$1' is damaged"
}

# Run the AWS CLI with the given credentials only: no profile, no config file,
# no credentials file. That is what stops credential_process from calling itself.
# The values go in through exported variables, never through the argument list.
aws_with() {   # AKID SECRET TOKEN(or "") -- aws arguments
    local a="$1" s="$2" t="$3"; shift 3
    (
        unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN
        export AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null
        export AWS_ACCESS_KEY_ID="$a" AWS_SECRET_ACCESS_KEY="$s"
        [ -n "$t" ] && export AWS_SESSION_TOKEN="$t"
        exec aws "$@"
    )
}

# The only two places that build a cache path. With no cache both do nothing:
# no path is ever made from an empty AWSV_RUN.
cache_file() { [ -n "$AWSV_RUN" ] && printf '%s/%s\n' "$AWSV_RUN" "$1"; }
drop_cache() {   # NAME, or no argument for every session
    [ -n "$AWSV_RUN" ] && [ -d "$AWSV_RUN" ] || return 0
    if [ -n "${1:-}" ]; then rm -f -- "$AWSV_RUN/$1"; else rm -f -- "$AWSV_RUN"/*; fi
}

session_creds() {   # NAME — sets SAKID SSECRET STOKEN SEXP, from the cache or from STS
    local name="$1" cache now exp out errf region
    cache="$(cache_file "$name")"
    now="$(date +%s)"
    if [ -n "$cache" ] && [ -f "$cache" ]; then
        { read -r SAKID; read -r SSECRET; read -r STOKEN; read -r SEXP; } < "$cache"
        exp="$(date -d "$SEXP" +%s 2>/dev/null || echo 0)"
        [ "$exp" -gt $((now + 300)) ] && return 0       # still valid for 5 minutes
    fi
    decrypt_key "$name"
    region="$(meta_get "$name" region)"
    errf="$(mktemp)"
    out="$(aws_with "$AKID" "$SECRET" "" sts get-session-token \
             --duration-seconds "$SESSION_SECONDS" --region "${region:-us-east-1}" \
             --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken,Expiration]' \
             --output text 2>"$errf")" \
        || { local e; e="$(grep -v '^$' "$errf" | tail -1)"; rm -f "$errf"
             die "STS refused a session for '$name': $e"; }
    rm -f "$errf"
    read -r SAKID SSECRET STOKEN SEXP <<< "$out"
    [ -n "$STOKEN" ] || die "STS returned no session for '$name'"
    # The cache is an optimisation: when it cannot be written, the session is
    # still returned, and the next call asks STS again.
    if [ -n "$cache" ] && mkdir -p "$AWSV_RUN" 2>/dev/null && chmod 700 "$AWSV_RUN" 2>/dev/null; then
        printf '%s\n%s\n%s\n%s\n' "$SAKID" "$SSECRET" "$STOKEN" "$SEXP" > "$cache.tmp" 2>/dev/null \
            && mv -f "$cache.tmp" "$cache"
    fi
    return 0
}

# ------------------------------------------------------------ ~/.aws/config

outside_block() {   # the config file without the awsv block
    [ -f "$CONFIG" ] || return 0
    awk -v b="$BEGIN" -v e="$END" '$0==b {skip=1; next} $0==e {skip=0; next} !skip' "$CONFIG"
}

conflicts() {   # names awsv generates that the rest of the file defines too
    local want=" default " f
    for f in "$KEYS"/*.gpg; do [ -e "$f" ] && want+="$(basename "$f" .gpg) "; done
    outside_block \
        | sed -nE 's/^[[:space:]]*\[(profile[[:space:]]+)?([^]]+)\].*/\2/p' \
        | while IFS= read -r s; do case "$want" in *" $s "*) printf '%s ' "$s";; esac; done
}

render_block() {
    local act f n
    act="$(active)"
    printf '%s\n' "$BEGIN"
    if [ -n "$act" ] && exists "$act"; then
        printf '[default]\nregion = %s\noutput = json\ncredential_process = %s creds %s\n\n' \
            "$(meta_get "$act" region)" "$BIN" "$act"
    else
        printf '# no active account — run: awsv use NAME\n\n'
    fi
    for f in "$KEYS"/*.gpg; do
        [ -e "$f" ] || continue
        n="$(basename "$f" .gpg)"
        printf '[profile %s]\nregion = %s\noutput = json\ncredential_process = %s creds %s\n\n' \
            "$n" "$(meta_get "$n" region)" "$BIN" "$n"
    done
    printf '%s\n' "$END"
}

check_config() {
    local c; c="$(conflicts)"
    [ -z "$c" ] && return 0
    die "~/.aws/config already defines [${c% }] outside the awsv block. For [default] run 'awsv init --take-default'; rename or remove any other by hand."
}

write_config() {
    check_config
    mkdir -p "$(dirname "$CONFIG")" "$BACKUP"
    if [ -f "$CONFIG" ]; then
        cp -p "$CONFIG" "$BACKUP/config.$(date +%s%N)"
        ls -1t "$BACKUP"/config.* 2>/dev/null | tail -n +11 | xargs -r rm -f
    fi
    {   # the user's part, trailing blank lines dropped, then one blank line and the block
        outside_block | awk 'NF {for (; n > 0; n--) print ""; print; next} {n++}'
        printf '\n'
        render_block
    } > "$CONFIG.tmp"
    mv -f "$CONFIG.tmp" "$CONFIG"
    chmod 600 "$CONFIG"
}

take_default() {   # comment out [default] and [profile default] outside the block
    [ -f "$CONFIG" ] || return 0
    mkdir -p "$BACKUP"
    cp -p "$CONFIG" "$BACKUP/config.$(date +%s%N)"
    awk -v b="$BEGIN" -v e="$END" '
        $0 == b {inb = 1} $0 == e {inb = 0; print; next}
        inb {print; next}
        /^[[:space:]]*#?[[:space:]]*\[/ {
            cur = ($0 ~ /^[[:space:]]*\[(profile[[:space:]]+)?default\]/)
        }
        cur && NF {print "# awsv: " $0; next}   # a blank line stays blank
        {print}' "$CONFIG" > "$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
}

# ------------------------------------------------------- ~/.aws/credentials

# Print AKID=… and SECRET=… for one section. An active [s] uses its active
# lines; a commented #[s] uses its commented lines.
read_section() {
    awk -v s="$1" '
        function hdr(line,   h) { h = line; sub(/^[[:space:]]*#?[[:space:]]*/, "", h); return h }
        /^[[:space:]]*#?[[:space:]]*\[/ {
            com = ($0 ~ /^[[:space:]]*#/)
            ins = (hdr($0) == "[" s "]")
            if (ins) found++
            next
        }
        ins {
            l = $0
            if (com) { if (l !~ /^[[:space:]]*#/) next; sub(/^[[:space:]]*#[[:space:]]*/, "", l) }
            else if (l ~ /^[[:space:]]*#/) next
            if (l !~ /=/) next
            k = l; sub(/[[:space:]]*=.*/, "", k); gsub(/[[:space:]]/, "", k)
            v = l; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
            if (k == "aws_access_key_id")     print "AKID=" v
            if (k == "aws_secret_access_key") print "SECRET=" v
            if (k == "aws_session_token")     print "TOKEN=1"
        }
        END { print "FOUND=" found+0 }' "$CREDS"
}

drop_section() {   # remove [s] or #[s] with its lines; keep an encrypted backup first
    local f; f="$(fpr)"
    mkdir -p "$BACKUP"
    gpg --quiet --yes --trust-model always --encrypt --recipient "$f" \
        --output "$BACKUP/credentials.$(date +%s%N).gpg" "$CREDS" \
        || die "could not back up the credentials file; nothing was removed"
    awk -v s="$1" '
        /^[[:space:]]*#?[[:space:]]*\[/ {
            h = $0; sub(/^[[:space:]]*#?[[:space:]]*/, "", h); del = (h == "[" s "]")
        }
        !del' "$CREDS" > "$CREDS.tmp" && mv -f "$CREDS.tmp" "$CREDS"
    chmod 600 "$CREDS"
}

plain_keys_left() {   # active key lines still in the credentials file
    [ -f "$CREDS" ] || { echo 0; return; }
    grep -cE '^[[:space:]]*aws_access_key_id[[:space:]]*=' "$CREDS"
}

# ------------------------------------------------------------- the commands

parse_opts() {   # sets REGION MODE VERIFY STDIN AS KEEP YES from the remaining arguments
    REGION=""; MODE=""; VERIFY=1; STDIN=0; AS=""; KEEP=0; YES=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --region)    REGION="${2:-}"; shift ;;
            --mode)      MODE="${2:-}"; shift ;;
            --no-verify) VERIFY=0 ;;
            --stdin)     STDIN=1 ;;
            --as)        AS="${2:-}"; shift ;;
            --keep)      KEEP=1 ;;
            --yes)       YES=1 ;;
            *)           die "unknown option '$1' (try --help)" ;;
        esac
        shift
    done
    [ -z "$REGION" ] || valid_region "$REGION"
    [ -z "$MODE" ] || valid_mode "$MODE"
}

read_key() {   # sets AKID SECRET from the terminal or from stdin
    if [ "$STDIN" = 1 ]; then
        IFS= read -r AKID; IFS= read -r SECRET
    else
        need_tty "typing a key in"
        read -rp 'Access key id: ' AKID
        read -rsp 'Secret access key (hidden): ' SECRET; printf '\n'
    fi
    [[ "$AKID" =~ ^A[KS]IA[A-Z0-9]{12,}$ ]] || die "that does not look like an access key id"
    [ -n "$SECRET" ] || die "empty secret"
}

store() {   # NAME REGION MODE — AKID and SECRET are set
    local name="$1" region="$2" mode="$3" id=""
    if [ "$VERIFY" = 1 ]; then
        id="$(aws_with "$AKID" "$SECRET" "" sts get-caller-identity --region "$region" \
                --query '[Account,Arn]' --output text 2>&1)" \
            || die "AWS rejected the key: $(printf '%s' "$id" | grep -v '^$' | tail -1)"
    fi
    encrypt_key "$name"
    : > "$META/$name" 2>/dev/null || { mkdir -p "$META"; : > "$META/$name"; }
    meta_set "$name" region "$region"
    meta_set "$name" mode "$mode"
    meta_set "$name" added "$(date -Is)"
    if [ -n "$id" ]; then
        meta_set "$name" account "$(printf '%s' "$id" | awk '{print $1}')"
        meta_set "$name" arn "$(printf '%s' "$id" | awk '{print $2}')"
    fi
    [ -n "$(active)" ] || printf '%s\n' "$name" > "$AWSV_HOME/active"
    drop_cache "$name"
    write_config
    ok "stored $name — $mode mode, $region${id:+, $(meta_get "$name" arn)}"
    [ "$(active)" = "$name" ] && say "  ${B}it is the [default] profile now${N}"
    [ "$mode" = session ] && warn "  session mode: an STS session made without MFA cannot call the IAM API. If a tool needs it: awsv set $name --mode direct"
    return 0
}

cmd_init() {
    local take=0 conf ttl
    [ "${1:-}" = --take-default ] && take=1
    mkdir -p "$KEYS" "$META" "$BACKUP"; chmod 700 "$AWSV_HOME"
    if [ -z "$(fpr)" ]; then
        need_tty "creating the GPG key"
        say "Creating the GPG key '$GPG_UID'."
        say "${Y}${B}Choose its passphrase now.${N} ${B}It is the one password for every account in the vault.${N}"
        gpg --quick-generate-key "$GPG_UID" future-default default never >/dev/null \
            || die "the key was not created"
    fi
    conf="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf"
    if ! grep -q '^default-cache-ttl' "$conf" 2>/dev/null; then
        [ -f "$conf" ] && cp -p "$conf" "$BACKUP/gpg-agent.conf.$(date +%s)"
        {
            printf '# awsv: the passphrase is asked once and kept for 8 hours\n'
            printf 'default-cache-ttl 28800\nmax-cache-ttl 28800\n'
            printf 'pinentry-program /usr/bin/pinentry-curses\n'
        } >> "$conf"
        gpgconf --reload gpg-agent
    fi
    if ! grep -q 'GPG_TTY' "$HOME/.bashrc" 2>/dev/null; then
        [ -f "$HOME/.bashrc" ] && cp -p "$HOME/.bashrc" "$BACKUP/bashrc.$(date +%s)"
        printf '\n# awsv: lets gpg ask for the passphrase in this terminal\nexport GPG_TTY=$(tty)\n' \
            >> "$HOME/.bashrc"
        warn "added 'export GPG_TTY=\$(tty)' to ~/.bashrc — open a new terminal, or run that line once here"
    fi
    [ "$take" = 1 ] && take_default && warn "commented out [default] in ~/.aws/config (backup in $BACKUP)"
    ttl="$(sed -n 's/^max-cache-ttl[[:space:]]*//p' "$conf" | head -1)"
    ok "ready: GPG key $(fpr | tail -c 17), passphrase kept for $((ttl / 3600)) h after it is typed"
}

cmd_add() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv add NAME [--region R] [--mode M]"
    shift; valid_name "$name"; parse_opts "$@"
    exists "$name" && die "'$name' is in the vault already — to replace its key: awsv rekey $name"
    [ -n "$(fpr)" ] || die "no GPG key yet — run 'awsv init' first"
    check_config
    read_key
    store "$name" "${REGION:-us-east-1}" "${MODE:-session}"
}

cmd_import() {
    local sec="${1:-}" name vals FOUND=0 TOKEN=""
    [ -n "$sec" ] || die "usage: awsv import SECTION [--as NAME] [--keep] [--region R] [--mode M]"
    shift; parse_opts "$@"
    name="${AS:-$sec}"; valid_name "$name"
    [ -f "$CREDS" ] || die "no $CREDS"
    exists "$name" && die "'$name' is in the vault already"
    [ -n "$(fpr)" ] || die "no GPG key yet — run 'awsv init' first"
    vals="$(read_section "$sec")"
    AKID="$(printf '%s\n' "$vals" | sed -n 's/^AKID=//p')"
    SECRET="$(printf '%s\n' "$vals" | sed -n 's/^SECRET=//p')"
    FOUND="$(printf '%s\n' "$vals" | sed -n 's/^FOUND=//p')"
    TOKEN="$(printf '%s\n' "$vals" | sed -n 's/^TOKEN=//p')"
    [ "$FOUND" -ge 1 ] || die "no section [$sec] in $CREDS, active or commented"
    [ "$FOUND" -le 1 ] || die "[$sec] is in $CREDS more than once; leave one and run again"
    [ -z "$TOKEN" ] || die "[$sec] holds a session token — that is a temporary key, nothing to vault"
    [ -n "$AKID" ] && [ -n "$SECRET" ] || die "[$sec] has no aws_access_key_id / aws_secret_access_key"
    # The check runs before the key is stored, so a failure leaves both files as they were.
    check_config
    store "$name" "${REGION:-us-east-1}" "${MODE:-session}"
    if [ "$KEEP" = 0 ]; then
        drop_section "$sec"
        ok "  removed [$sec] from $CREDS (encrypted backup in $BACKUP)"
    fi
}

cmd_ls() {
    local f n act any=0
    act="$(active)"
    printf '%s%-14s %-7s %-8s %-12s %-14s %s%s\n' "$B" NAME DEFAULT MODE REGION ACCOUNT ARN "$N"
    for f in "$KEYS"/*.gpg; do
        [ -e "$f" ] || continue; any=1
        n="$(basename "$f" .gpg)"
        # the whole row in one colour: escape codes inside a padded column break the alignment
        printf '%s%-14s %-7s %-8s %-12s %-14s %s%s\n' "$([ "$n" = "$act" ] && printf '%s' "$G$B")" \
            "$n" "$([ "$n" = "$act" ] && echo '*')" \
            "$(meta_get "$n" mode)" "$(meta_get "$n" region)" \
            "$(meta_get "$n" account)" "$(meta_get "$n" arn)" "$N"
    done
    [ "$any" = 1 ] || say "${D}(the vault is empty — awsv add NAME, or awsv import SECTION)${N}"
}

cmd_use() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv use NAME"
    need "$name"
    printf '%s\n' "$name" > "$AWSV_HOME/active"
    write_config
    ok "[default] is $name now — $(meta_get "$name" arn)"
}

cmd_set() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv set NAME [--region R] [--mode M]"
    shift; need "$name"; parse_opts "$@"
    [ -n "$REGION$MODE" ] || die "nothing to change: give --region or --mode"
    [ -z "$REGION" ] || meta_set "$name" region "$REGION"
    [ -z "$MODE" ] || meta_set "$name" mode "$MODE"
    drop_cache "$name"
    write_config
    ok "$name: $(meta_get "$name" mode) mode, $(meta_get "$name" region)"
}

cmd_rekey() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv rekey NAME"
    shift; need "$name"; parse_opts "$@"
    read_key
    store "$name" "$(meta_get "$name" region)" "$(meta_get "$name" mode)"
    warn "  the old key is still valid in AWS until you deactivate it in IAM"
}

cmd_rm() {
    local name="${1:-}" a; [ -n "$name" ] || die "usage: awsv rm NAME [--yes]"
    shift; need "$name"; parse_opts "$@"
    if [ "$YES" = 0 ]; then
        need_tty "a confirmation (or pass --yes)"
        read -rp "${R}${B}Delete $name${N} ($(meta_get "$name" arn)) from the vault? [y/N] " a
        [ "$a" = y ] || [ "$a" = Y ] || die "nothing deleted"
    fi
    rm -f "$KEYS/$name.gpg" "$META/$name"
    drop_cache "$name"
    [ "$(active)" = "$name" ] && : > "$AWSV_HOME/active"
    write_config
    ok "removed $name"
    warn "  its key is still valid in AWS — deactivate it in IAM if it is no longer needed"
    [ -n "$(active)" ] || warn "  no [default] profile now — awsv use NAME"
}

cmd_exec() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv exec NAME -- CMD [ARGS]"
    shift; need "$name"
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "usage: awsv exec NAME -- CMD [ARGS]"
    unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN
    if [ "$(meta_get "$name" mode)" = direct ]; then
        decrypt_key "$name"
        export AWS_ACCESS_KEY_ID="$AKID" AWS_SECRET_ACCESS_KEY="$SECRET"
    else
        session_creds "$name"
        export AWS_ACCESS_KEY_ID="$SAKID" AWS_SECRET_ACCESS_KEY="$SSECRET" AWS_SESSION_TOKEN="$STOKEN"
    fi
    export AWS_REGION="${AWS_REGION:-$(meta_get "$name" region)}"
    exec "$@"
}

cmd_creds() {   # the credential_process entry point
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv creds NAME"
    need "$name"
    if [ "$(meta_get "$name" mode)" = direct ]; then
        decrypt_key "$name"
        printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s"}\n' "$AKID" "$SECRET"
    else
        session_creds "$name"
        printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s","SessionToken":"%s","Expiration":"%s"}\n' \
            "$SAKID" "$SSECRET" "$STOKEN" "$SEXP"
    fi
}

cmd_unlock() {
    local f
    need_tty "unlock"
    for f in "$KEYS"/*.gpg; do [ -e "$f" ] && break; done
    [ -e "${f:-}" ] || die "the vault is empty — nothing to unlock"
    gpg --quiet --decrypt "$f" >/dev/null || die "not unlocked"
    ok "unlocked: tools, and the assistant in this machine's shell, can use the vault until the agent forgets"
}

cmd_lock() {
    gpgconf --reload gpg-agent
    drop_cache
    ok "locked: the agent forgot the passphrase and every cached session is deleted"
}

# Print a stored key. Only when both stdin and stdout are a terminal: a pipe, a
# script or an assistant's shell would keep the secret in a log or a transcript.
cmd_show() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv show NAME"
    need "$name"
    { [ -t 0 ] && [ -t 1 ]; } \
        || die "show prints a secret, so it runs only in a terminal — not in a pipe, a script or an assistant's shell"
    GPG_TTY="$(tty)"; export GPG_TTY
    decrypt_key "$name"
    warn "The secret key of $name. Clear the screen when you are done."
    say "aws_access_key_id     = $AKID"
    say "aws_secret_access_key = $SECRET"
}

# The passphrase protects the GPG key, not each file in keys/: changing it
# re-encrypts nothing, and every account keeps working.
cmd_passwd() {
    local f
    need_tty "changing the passphrase"
    f="$(fpr)"; [ -n "$f" ] || die "no GPG key yet — run 'awsv init' first"
    say "gpg asks for the current passphrase, then for the new one twice."
    gpg --change-passphrase "$f" || die "the passphrase was not changed"
    gpgconf --reload gpg-agent
    ok "passphrase changed — the next use asks for the new one"
}

cmd_status() {
    local act g st n f exp left
    act="$(active)"
    say "vault:        $AWSV_HOME — $(ls "$KEYS"/*.gpg 2>/dev/null | wc -l) account(s)"
    say "[default]:    ${B}${act:-none}${N}${act:+ — $(meta_get "$act" arn)}"
    if [ -z "$(fpr)" ]; then say "GPG key:      ${Y}none — run 'awsv init'${N}"; else
        say "GPG key:      $(fpr | tail -c 17)"
        g="$(grip)"
        st="$(gpg-connect-agent "keyinfo $g" /bye 2>/dev/null | awk '$2 == "KEYINFO" {print $7}')"
        case "$st" in
            1) say "agent:        ${G}unlocked${N} — the passphrase is cached" ;;
            *) say "agent:        ${Y}locked${N} — the next use asks for the passphrase (awsv unlock)" ;;
        esac
    fi
    if [ -n "$AWSV_RUN" ]; then
        say "cache:        $AWSV_RUN"
    else
        say "cache:        ${Y}none${N} — no private tmpfs, so every call asks STS for a session"
    fi
    for f in ${AWSV_RUN:+"$AWSV_RUN"/*}; do
        [ -f "$f" ] || continue
        n="$(basename "$f")"; exp="$(sed -n 4p "$f")"
        say "session:      ${C}$n${N} until $(date -d "$exp" '+%H:%M %Z' 2>/dev/null || echo "$exp")"
    done
    left="$(plain_keys_left)"
    if [ "$left" -gt 0 ]; then
        say "${R}${B}WARNING:${N}      ${R}$CREDS still holds $left key(s) in plain text.${N}"
        say "              A key there overrides credential_process — the vault is not used for that profile."
    else
        say "plain text:   ${G}no keys left in $CREDS${N}"
    fi
}

# ------------------------------------------------------------------- main

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
    init)   cmd_init "$@" ;;
    add)    cmd_add "$@" ;;
    import) cmd_import "$@" ;;
    ls|list) cmd_ls ;;
    use)    cmd_use "$@" ;;
    set)    cmd_set "$@" ;;
    rekey)  cmd_rekey "$@" ;;
    rm|remove) cmd_rm "$@" ;;
    exec)   cmd_exec "$@" ;;
    creds)  cmd_creds "$@" ;;
    unlock) cmd_unlock ;;
    show)   cmd_show "$@" ;;
    passwd) cmd_passwd ;;
    lock)   cmd_lock ;;
    status) cmd_status ;;
    ""|-h|--help|help) cmd_help "$@" ;;
    *)      die "unknown command '$cmd' (try --help)" ;;
esac
