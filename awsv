#!/usr/bin/env bash
#
# awsv — keep AWS access keys in a GPG-encrypted vault, not in ~/.aws/credentials.
#
# The user guide is built in: 'awsv help', or 'awsv help COMMAND' for one command
# with its examples. Its text is help_text() below — edit it there, not here.

set -uo pipefail
umask 077

AWSV_HOME="${AWSV_HOME:-$HOME/.local/share/awsv}"
# Cached STS sessions live on a private tmpfs, so a reboot clears them.
#   AWSV_RUN set            that directory; set it empty to turn the cache off
#   $XDG_RUNTIME_DIR/awsv   a normal user: /run/user/UID, private, made at login
#   /run/awsv               root without XDG_RUNTIME_DIR
#   none                    no private tmpfs: no cache, and every call asks STS
# A normal user cannot write to /run, so /run/awsv is for root only.
if [ -z "${AWSV_RUN+x}" ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        AWSV_RUN="$XDG_RUNTIME_DIR/awsv"
    elif [ "$(id -u)" = 0 ]; then
        AWSV_RUN=/run/awsv
    else
        AWSV_RUN=""
    fi
fi
# Every cache path is built from this value, and a cache path is deleted with
# rm. An empty or relative value must never turn into a path under / .
case "$AWSV_RUN" in
    "") ;;
    /) printf 'awsv: AWSV_RUN cannot be /\n' >&2; exit 1 ;;
    /*) ;;
    *) printf 'awsv: AWSV_RUN must be an absolute path, not %s\n' "$AWSV_RUN" >&2; exit 1 ;;
esac
CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
CREDS="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
SESSION_SECONDS="${AWSV_SESSION_SECONDS:-3600}"
GPG_UID="awsv local vault"
SELF="$(readlink -f "$0")"
# The path written into ~/.aws/config. The installed copy, when there is one:
# a run straight from the repository must not tie the config to the work tree.
BIN="$(readlink -f "$(command -v awsv 2>/dev/null || echo "$SELF")")"
KEYS="$AWSV_HOME/keys"
META="$AWSV_HOME/meta"
BACKUP="$AWSV_HOME/backup"
# An account with a passphrase of its own has a GPG home of its own here. A
# separate home means a separate gpg-agent: its own cached passphrase, its own
# unlock window, its own lock. Accounts on the shared passphrase use ~/.gnupg.
LOCKS="$AWSV_HOME/gnupg"
MAIN_GNUPG="${GNUPGHOME:-$HOME/.gnupg}"
BEGIN="# >>> awsv: generated, do not edit between these two lines >>>"
END="# <<< awsv <<<"

# Colour only on a terminal. "awsv creds" writes JSON for the AWS CLI to parse,
# and an escape code in it would break every call; NO_COLOR turns it off too.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' C=$'\e[36m' D=$'\e[2m' N=$'\e[0m'
    BY=$'\e[1;93m' BC=$'\e[1;96m'     # bright yellow, bright cyan
    YG=$'\e[1;93;42m'                  # bright yellow on dark green: time left in the window
else
    B="" G="" Y="" R="" C="" D="" N="" BY="" BC="" YG=""
fi
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    EB=$'\e[1m' ER=$'\e[31m' EY=$'\e[33m' EN=$'\e[0m'
else
    EB="" ER="" EY="" EN=""
fi

die()  { printf '%sawsv: %s%s\n' "$ER$EB" "$*" "$EN" >&2; exit 1; }
warn() { printf '%s%s%s\n' "$EY" "$*" "$EN" >&2; }
ok()   { printf '%s%s%s\n' "$G" "$*" "$N"; }
say()  { printf '%s\n' "$*"; }
help_text() {
cat <<'EOF'
awsv keeps AWS access keys in an encrypted vault, not in ~/.aws/credentials.
aws, Terraform and the SDKs get the keys through ~/.aws/config.
A passphrase opens it for as long as you choose: awsv unlock 30m, awsv unlock 8h.
One passphrase for every account, or one for each: awsv help passphrase
What an open vault does not protect: awsv help show

  awsv help COMMAND    one command and its example
  awsv help            this page

  Words in capitals are yours to fill in: NAME is an account name such as work,
  SECTION is a section of ~/.aws/credentials, REGION is an AWS region.

START HERE
    $ ./install.sh                        # in the awsv repository: check the parts, install
    $ awsv init --take-default            # asks: one passphrase for all accounts, or one for each
    $ awsv import default --as work       # move the current [default] key into the vault
    $ awsv status                         # "no keys left" means done

ONE PASSPHRASE, OR ONE PER ACCOUNT
    $ awsv help passphrase                # how both work, and how to switch an account

SEE A STORED KEY
  ! awsv show NAME
  ! It prints the secret, and so does gpg --decrypt: awsv help show has the exact line.
  ! Run them only in your own terminal.

COMMANDS
    $ awsv use NAME                       # switch the [default] account: plain aws runs as NAME
    $ awsv exec NAME -- CMD               # run one command as NAME; [default] stays as it is
    $ awsv ls                             # list the accounts; * marks [default]
    $ awsv status                         # what is open, what is locked, what is left to move
    $ awsv unlock 8h                      # open for a working day; or 30m, or NAME 30m
    $ awsv lock                           # close everything now
    $ awsv add NAME                       # store a new account: type its key in
    $ awsv import SECTION                 # move a key out of ~/.aws/credentials
    $ awsv set NAME --mode direct         # change the region, the mode or the passphrase
    $ awsv rekey NAME                     # a new key for an account, after rotating it in IAM
    $ awsv rm NAME                        # remove an account from the vault
    $ awsv passwd                         # change a passphrase
    $ awsv show NAME                      # print a stored key; only in your own terminal
    $ awsv init                           # set up the vault, once
    $ awsv help COMMAND                   # one command in full, with examples

FILES
  ~/.local/share/awsv/keys/NAME.gpg   the key of one account, encrypted
  ~/.local/share/awsv/gnupg/NAME/     the GPG key of an account with its own passphrase
  ~/.local/share/awsv/meta/NAME       region, mode, lock and account number; not secret
  ~/.local/share/awsv/active          the name of the [default] account
  ~/.local/share/awsv/backup/         copies made before each change
  ~/.aws/config                       awsv writes only between its two marker lines
  ~/.aws/credentials                  stays empty; do not put keys there

@ init | set up the vault; run it once
    $ awsv init                         # asks: 1 one passphrase for all, 2 one per account
    $ awsv init --take-default          # the same, when ~/.aws/config has its own [default]
    $ awsv init --lock own              # answer in advance: each new account gets its own
    $ awsv init --lock shared           # answer in advance: one passphrase for all
  On a vault that exists, --lock changes what new accounts get. Existing ones stay.
  Then open a new terminal: init adds GPG_TTY to ~/.bashrc.

@ add | store a new account
    $ awsv add prod --region eu-central-1        # asks for the key id, then the secret (hidden)
    $ awsv add prod --lock own                   # prod gets a passphrase of its own
    $ aws --profile prod sts get-caller-identity # check that it works
    $ awsv use prod                              # make it [default], if you want
  Type the key here. Do not put it into ~/.aws/credentials first.
  AWS checks the key before awsv stores it.
  With a passphrase of its own, add asks you to choose it, twice.
  No --lock, and new accounts get the shared passphrase: add asks which one,
  1 shared or 2 its own. Without a terminal (--stdin) it takes the shared one.
  A shared result is said in yellow, with the command that gives it its own.
  import asks and warns the same way.

@ import | move a key from ~/.aws/credentials into the vault
    $ awsv import client                # works for [client] and for a commented #[client]
    $ awsv import default --as work     # "default" is reserved, so give it a name
    $ awsv import client --lock own     # client gets a passphrase of its own
    $ awsv status                       # repeat imports until "no keys left"
  The section leaves the file. An encrypted copy of the file goes to backup/.
  With a passphrase of its own, import asks you to choose it, twice.

@ ls | list the accounts
    $ awsv ls                           # * marks [default]; then mode, lock, region, account

@ use | change the [default] account
    $ awsv use client                   # plain "aws ..." now works as client
    $ aws s3 ls                         # runs as client
    $ awsv use sso                      # [default] is [profile sso] of ~/.aws/config, an SSO login say
  This replaces commenting sections in and out.
  NAME is an account of the vault, or a [profile NAME] that ~/.aws/config has
  outside the awsv block. Such a profile keeps its own way of getting keys; awsv
  hands them on with aws configure export-credentials. Terraform and the SDKs
  follow [default] the same way.

@ exec | run one command as another account
    $ awsv exec client -- terraform plan  # [default] does not change
    $ aws --profile client s3 ls        # the same for aws alone

@ set | change the region, the mode or the passphrase of an account
    $ awsv set client --region us-east-2
    $ awsv set work --mode direct       # tools get the key itself
    $ awsv set work --mode session      # tools get a one-hour session; the default
    $ awsv set client --lock own        # client gets a passphrase of its own
    $ awsv set client --lock shared     # client goes back to the shared passphrase
    $ awsv set client --mfa arn:aws:iam::111122223333:mfa/phone   # its policy requires MFA
    $ awsv set client --mfa none        # back to no MFA
  --mfa: aws gets the account only as a session made with an MFA code;
  unlock asks for the code. Accounts without --mfa are not affected.
  Use direct for Terraform. A session made without MFA cannot call the IAM API.
  A session also needs the account open again when it expires during a long run.
  --lock asks two things: first the passphrase that opens the account now,
  then the new one. Stopped or failed half-way, the account opens with the old
  passphrase, or with the new one once its key file is in place. Never with neither.

@ rekey | replace the key of an account
    $ awsv rekey work                   # type the new key from IAM; AWS checks it first
  Then deactivate the old key in IAM. AWS still accepts it.

@ rm | remove an account
    $ awsv use work                     # first, when old is [default]: rm refuses it
    $ awsv rm old                       # asks you to confirm
  Then deactivate the key in IAM. Removal from the vault does not revoke it.
  An account with its own passphrase loses its GPG key too.

@ show | see a stored key, and what the vault does not protect
  ! awsv show work
  !   prints the key id and the secret
  !   the same with gpg, shared passphrase: gpg --decrypt ~/.local/share/awsv/keys/work.gpg
  !   own passphrase: gpg --homedir ~/.local/share/awsv/gnupg/work --decrypt ~/.local/share/awsv/keys/work.gpg
  It asks for the passphrase when the account is locked.
  It refuses in a pipe, a script or an assistant's shell, so the secret stays out of logs.

  ! While an account is open, nothing asks before its key is read.
  ! Any process of this user can run gpg --decrypt and get the key.
  ! This includes scripts and an AI assistant that runs as you.

  The vault protects                  The vault does not protect
  the keys on disk                    an open account's key from
  backups and disk snapshots            processes of this user
  the keys from other users           the keys from a root session
  the keys after lock, the end of     a key someone printed while
    the unlock window, or a reboot      the account was open
  a locked account while another
    one with its own passphrase is open

@ passwd | change a passphrase
    $ awsv passwd                       # the shared one: the current passphrase, then the new one twice
    $ awsv passwd client                # the passphrase that opens client: its own, or the shared one
  The files in keys/ do not change. A passphrase locks a GPG key, not each file.

@ unlock | open for a time you choose
    $ awsv unlock 30m                   # the passphrase of the [default] account, for 30 minutes
    $ awsv unlock 8h                    # a working day; also what plain "awsv unlock" does
    $ awsv unlock client 30m            # the passphrase that opens client
    $ awsv unlock all 8h                # every passphrase, one after another
    $ awsv unlock 1h30m                 # any mix of hours and minutes, up to 24h
    $ awsv status                       # shows when each one closes
  A shared passphrase opens every account on it at once.
  Running unlock again starts a new window; the old one ends at once.
  "Error when retrieving credentials from custom-process" means: run awsv unlock.
  An account with --mfa: after the passphrase, unlock asks for the MFA code and
  makes a session that lasts as long as the window.

@ lock | close now
    $ awsv lock                         # every passphrase, and every cached session
    $ awsv lock client                  # only the passphrase that opens client

@ status | check the state
    $ awsv status
  VAULT: what new accounts get, the shared passphrase and whether it is open,
  where sessions are kept, and whether any key is still in ~/.aws/credentials.
  ACCOUNTS: one block per account in the same shape. * marks [default].
  "lock" says which passphrase opens the account. "state" says whether it is
  open now, and gives the command that opens or closes it.
  Each block ends with the command that uses the account.

@ passphrase | one passphrase for every account, or one for each
  shared   one passphrase opens every account on it. You type it once.
  own      the account has a passphrase of its own. It opens and closes alone.
  init asks which one new accounts get. Each account can be switched later.

  Give one account its own passphrase, keep the others shared:
    $ awsv set client --lock own        # the current passphrase, then a new one for client
    $ awsv unlock client 30m            # opens client only
    $ awsv lock client                  # closes client only
    $ awsv passwd client                # changes the passphrase of client only
    $ awsv set client --lock shared     # back to the shared passphrase
  Every new account with its own passphrase:
    $ awsv init --lock own              # accounts that exist keep their lock
    $ awsv add prod --lock shared       # one account can still take the shared one
  Open everything in the morning, close it in the evening:
    $ awsv unlock all 8h                # asks each passphrase once
    $ awsv lock                         # closes every passphrase

  unlock is per passphrase, not per account: one unlock for the shared one,
  one for each account with its own. In your own terminal unlock is optional:
  the first aws command in a locked account asks for its passphrase.
  Cron, scripts and assistants have no terminal: open the account for them first.
  ! A shared passphrase opens every account on it: awsv unlock work 30m opens them all.
  ! awsv status shows, for each account, which passphrase opens it and whether it is open.
EOF
}

topics() { help_text | sed -n 's/^@ \([a-z]*\) |.*/\1/p' | tr '\n' ' '; }

# On a terminal: headings bold, commands coloured, warnings yellow.
# "@ command | what it does" opens a section; "    $ ..." is a line to type;
# "  ! ..." is a warning. With a TOPIC, only that section is printed.
render_help() {
    help_text | awk -v t="${1:-}" -v b="$B" -v c="$C" -v n="$N" -v d="$D" -v y="$Y" '
        /^@ / {
            h = substr($0, 3); i = index(h, " | ")
            sec = substr(h, 1, i - 1); title = substr(h, i + 3)
            show = (t == "" || t == sec); if (t == sec) found = 1
            if (show) { if (t == "") print ""; printf "%s%s — %s%s\n", b, sec, title, n }
            next
        }
        t != "" && sec == "" { next }       # with a topic, skip the general part
        sec != "" && !show { next }
        /^    \$ / {                         # a line to type; "  # why" after it is dimmed
            l = $0; sub(/^    \$ /, "", l); i = index(l, "  #")
            if (i) { cmd = substr(l, 1, i - 1); com = substr(l, i) } else { cmd = l; com = "" }
            printf "    %s%s%s%s%s%s\n", c, cmd, n, d, com, n; next
        }
        /^  ! / { l = $0; sub(/^  ! /, "", l); printf "  %s%s%s\n", y, l, n; next }   # a warning
        /^[A-Z][A-Z ]+$/ { printf "%s%s%s\n", b, $0, n; next }
        { print }
        END { if (t != "" && !found) exit 3 }'
}

cmd_help() {
    local topic="${1:-}"
    if [ -n "$topic" ]; then
        render_help "$topic" || die "no help topic '$topic' — topics: $(topics)"
    elif [ -t 1 ] && command -v less >/dev/null 2>&1; then
        render_help "" | less -RFX
    else
        render_help ""
    fi
}

# ---------------------------------------------------------------- helpers

valid_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] \
        || die "bad name '$1': use lowercase letters, digits, '-' and '_', up to 32"
    [ "$1" != default ] \
        || die "'default' is reserved: it is the account that 'awsv use NAME' selected"
    [ "$1" != all ] || die "'all' is reserved: 'awsv unlock all' opens every account"
}
valid_region() { [[ "$1" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]] || die "bad region '$1'"; }
valid_mode()   { [ "$1" = session ] || [ "$1" = direct ] || die "mode is 'session' or 'direct', not '$1'"; }
exists()       { [ -f "$KEYS/$1.gpg" ]; }
need()         { exists "$1" || die "no account '$1' in the vault — see 'awsv ls'"; }
active()       { cat "$AWSV_HOME/active" 2>/dev/null; }

need_tty() {
    { [ -t 0 ] && [ -t 1 ]; } || die "$1 needs a terminal"
    GPG_TTY="$(tty)"; export GPG_TTY
}

meta_get() { sed -n "s/^$2=//p" "$META/$1" 2>/dev/null | head -1; }

# ------------------------------------------------------------ the locks
#
# A lock is a GPG key and its passphrase. "shared": the vault key in ~/.gnupg,
# one passphrase for every account that uses it. "own": a key of one account
# in $LOCKS/NAME, with its own gpg-agent. Each helper takes the GPG home; an
# empty home means ~/.gnupg.

valid_lock() { [ "$1" = shared ] || [ "$1" = own ] || die "lock is 'shared' or 'own', not '$1'"; }
lock_of() {   # NAME
    local l from
    l="$(meta_get "$1" lock)"; from="$(meta_get "$1" relock_from)"
    # relock_from exists only while relock swaps the key file. Until the swap the
    # new file is still NAME.gpg.tmp, and the file in place is the old lock's.
    # Read from what is on disk, so a relock stopped anywhere opens with the
    # lock the file is really under — the old one, or the new one.
    [ -n "$from" ] && [ -f "$KEYS/$1.gpg.tmp" ] && l="$from"
    if [ "$l" = own ]; then echo own; else echo shared; fi
}
home_for() { [ "$2" = own ] && printf '%s\n' "$LOCKS/$1"; return 0; }   # NAME LOCK
uid_for()  { if [ "$2" = own ]; then printf 'awsv-%s\n' "$1"; else printf '%s\n' "$GPG_UID"; fi; }
home_of()  { home_for "$1" "$(lock_of "$1")"; }
uid_of()   { uid_for "$1" "$(lock_of "$1")"; }
default_lock() { if [ "$(cat "$AWSV_HOME/lock" 2>/dev/null)" = own ]; then echo own; else echo shared; fi; }

g() {   # HOME gpg-arguments — gpg in that GPG home
    local h="$1"; shift
    if [ -n "$h" ]; then gpg --homedir "$h" "$@"; else gpg "$@"; fi
}
fpr() {   # [HOME UID] — no arguments: the shared vault key
    g "${1:-}" --list-secret-keys --with-colons -- "${2:-$GPG_UID}" 2>/dev/null \
        | awk -F: '/^fpr:/ {print $10; exit}'
}
grip() {   # [HOME UID] — keygrip of the encryption subkey: what gpg-agent caches
    g "${1:-}" --list-secret-keys --with-colons --with-keygrip -- "${2:-$GPG_UID}" 2>/dev/null \
        | awk -F: '/^ssb:/ {s=1} s && /^grp:/ {print $10; exit}'
}
conf_of()  { printf '%s/gpg-agent.conf\n' "${1:-$MAIN_GNUPG}"; }
until_of() { printf '%s/unlocked-until\n' "${1:-$AWSV_HOME}"; }
initialized() { [ -n "$(fpr)" ] || [ -f "$AWSV_HOME/lock" ]; }

# Make gpg-agent forget the passphrase. The shared agent in ~/.gnupg is
# reloaded: it may serve other keys of this user. An account's own agent
# serves that account only, so it is stopped; the next gpg call starts it again.
forget() {   # HOME
    if [ -n "$1" ]; then gpgconf --homedir "$1" --kill gpg-agent 2>/dev/null
    else gpgconf --reload gpg-agent; fi
    return 0
}

cached() {   # HOME UID — is the passphrase in gpg-agent's memory now
    local gr a=(gpg-connect-agent --no-autostart)
    gr="$(grip "$1" "$2")"; [ -n "$gr" ] || return 1
    [ -n "$1" ] && a+=(--homedir "$1")
    [ "$("${a[@]}" "keyinfo $gr" /bye 2>/dev/null | awk '$2 == "KEYINFO" {print $7}')" = 1 ]
}

names() {   # every account; with an argument, only the accounts on that lock
    local f n
    for f in "$KEYS"/*.gpg; do
        [ -e "$f" ] || continue
        n="$(basename "$f" .gpg)"
        [ -z "${1:-}" ] || [ "$(lock_of "$n")" = "$1" ] && printf '%s\n' "$n"
    done
}
joined() { tr '\n' ' ' | sed 's/ $//; s/ /, /g'; }

# What one lock opens, in words: "work, x — the shared passphrase" or "client only".
scope_of() {   # NAME
    if [ "$(lock_of "$1")" = own ]; then printf '%s only, with its own passphrase\n' "$1"
    else printf '%s — every account on the shared passphrase\n' "$(names shared | joined)"; fi
}

make_shared_key() {
    [ -n "$(fpr)" ] && return 0
    [ -t 0 ] && { GPG_TTY="$(tty)"; export GPG_TTY; }
    say "Creating the GPG key for the shared passphrase."
    say "${Y}${B}Choose the shared passphrase now.${N} ${B}It opens every account that uses it.${N}"
    gpg --quick-generate-key "$GPG_UID" future-default default never >/dev/null \
        || die "the key was not created — gpg asks for the passphrase in a terminal"
}

# The key of one account, in a GPG home of its own. Its gpg-agent takes the
# unlock window and the pinentry program from the shared one.
make_own_key() {   # NAME
    local h="$LOCKS/$1" pin ttl
    [ -n "$(fpr "$h" "awsv-$1")" ] && return 0
    mkdir -p "$h"; chmod 700 "$LOCKS" "$h"
    ttl="$(agent_ttl "")"; ttl="${ttl:-28800}"
    pin="$(sed -n 's/^pinentry-program[[:space:]]*//p' "$(conf_of "")" 2>/dev/null | head -1)"
    {
        printf '# awsv: how long the passphrase of %s stays in memory; awsv unlock %s sets it\n' "$1" "$1"
        printf 'default-cache-ttl %s\nmax-cache-ttl %s\n' "$ttl" "$ttl"
        [ -z "$pin" ] || printf 'pinentry-program %s\n' "$pin"
    } > "$(conf_of "$h")"
    [ -t 0 ] && { GPG_TTY="$(tty)"; export GPG_TTY; }
    say "${Y}${B}Choose the passphrase of $1 now.${N} ${B}It opens $1 only.${N}"
    g "$h" --quick-generate-key "awsv-$1" future-default default never >/dev/null \
        || die "the key of $1 was not created — gpg asks for the passphrase in a terminal"
}
meta_set() {
    local f="$META/$1"
    mkdir -p "$META"; touch "$f"
    if grep -q "^$2=" "$f"; then sed -i "s|^$2=.*|$2=$3|" "$f"
    else printf '%s=%s\n' "$2" "$3" >> "$f"; fi
}
meta_del() { [ -f "$META/$1" ] && sed -i "/^$2=/d" "$META/$1"; return 0; }   # NAME KEY

# --------------------------------------------------------- the vault itself

encrypt_key() {   # NAME LOCK — AKID and SECRET are set; creates the key of the lock if needed
    seal_key "$1" "$2"
    mv -f "$KEYS/$1.gpg.tmp" "$KEYS/$1.gpg"
}

seal_key() {   # NAME LOCK — encrypts into NAME.gpg.tmp and leaves it there
    local h u f
    if [ "$2" = own ]; then make_own_key "$1"; else make_shared_key; fi
    h="$(home_for "$1" "$2")"; u="$(uid_for "$1" "$2")"; f="$(fpr "$h" "$u")"
    [ -n "$f" ] || die "no GPG key for $1"
    mkdir -p "$KEYS"
    # printf is a shell builtin: the secret never appears in a process argument list.
    printf 'AccessKeyId=%s\nSecretAccessKey=%s\n' "$AKID" "$SECRET" \
        | g "$h" --quiet --yes --trust-model always --encrypt --recipient "$f" \
              --output "$KEYS/$1.gpg.tmp" \
        || die "encryption failed"
}

decrypt_key() {   # NAME — sets AKID and SECRET
    local out errf why
    errf="$(mktemp)"
    if ! out="$(g "$(home_of "$1")" --quiet --decrypt "$KEYS/$1.gpg" 2>"$errf" </dev/null)"; then
        why="$(grep -m1 -v '^gpg: encrypted with' "$errf")"; rm -f "$errf"
        die "cannot open '$1' — ${why:-gpg failed}. If it is locked, open it in your terminal: awsv unlock $1"
    fi
    rm -f "$errf"
    AKID="$(printf '%s\n' "$out" | sed -n 's/^AccessKeyId=//p')"
    SECRET="$(printf '%s\n' "$out" | sed -n 's/^SecretAccessKey=//p')"
    [ -n "$AKID" ] && [ -n "$SECRET" ] || die "the vault entry '$1' is damaged"
}

# Run the AWS CLI with the given credentials only: no profile, no config file,
# no credentials file. That is what stops credential_process from calling itself.
# The values go in through exported variables, never through the argument list.
aws_with() {   # AKID SECRET TOKEN(or "") -- aws arguments
    local akid="$1" secret="$2" token="$3"; shift 3
    (
        unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN
        export AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null
        export AWS_ACCESS_KEY_ID="$akid" AWS_SECRET_ACCESS_KEY="$secret"
        [ -n "$token" ] && export AWS_SESSION_TOKEN="$token"
        exec aws "$@"
    )
}

# The only two places that build a cache path. With no cache both do nothing:
# no path is ever made from an empty AWSV_RUN.
cache_file() { [ -n "$AWSV_RUN" ] && printf '%s/%s\n' "$AWSV_RUN" "$1"; }
drop_cache() {   # NAME, or no argument for every session
    [ -n "$AWSV_RUN" ] && [ -d "$AWSV_RUN" ] || return 0
    if [ -n "${1:-}" ]; then rm -f -- "$AWSV_RUN/$1"; else rm -f -- "$AWSV_RUN"/*; fi
}

session_creds() {   # NAME — sets SAKID SSECRET STOKEN SEXP, from the cache or from STS
    local name="$1" cache now exp out errf region mfa margin=300
    mfa="$(meta_get "$name" mfa)"
    [ -z "$mfa" ] || margin=60   # an MFA session cannot be renewed here: hand it out to the end
    cache="$(cache_file "$name")"
    now="$(date +%s)"
    if [ -n "$cache" ] && [ -f "$cache" ]; then
        # A cached session is handed out only while the passphrase that opens
        # the account is in gpg-agent's memory. When the unlock window ends,
        # the session ends with it, not up to an hour later (F520).
        if cached "$(home_of "$name")" "$(uid_of "$name")"; then
            { read -r SAKID; read -r SSECRET; read -r STOKEN; read -r SEXP; } < "$cache"
            exp="$(date -d "$SEXP" +%s 2>/dev/null || echo 0)"
            [ "$exp" -gt $((now + margin)) ] && return 0   # still valid for a while
        else
            rm -f -- "$cache"
        fi
    fi
    # Without the code there is no session to make: never fall back to one
    # without MFA, which the account's policy refuses anyway.
    [ -z "$mfa" ] || die "the MFA session of '$name' has ended or was never started — awsv unlock $name (it asks for the MFA code)"
    decrypt_key "$name"
    region="$(meta_get "$name" region)"
    errf="$(mktemp)"
    out="$(aws_with "$AKID" "$SECRET" "" sts get-session-token \
             --duration-seconds "$SESSION_SECONDS" --region "${region:-us-east-1}" \
             --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken,Expiration]' \
             --output text 2>"$errf")" \
        || { local e; e="$(grep -v '^$' "$errf" | tail -1)"; rm -f "$errf"
             die "STS refused a session for '$name': $e"; }
    rm -f "$errf"
    read -r SAKID SSECRET STOKEN SEXP <<< "$out"
    [ -n "$STOKEN" ] || die "STS returned no session for '$name'"
    save_session "$cache"
    return 0
}

save_session() {   # CACHEFILE — writes SAKID SSECRET STOKEN SEXP there
    local cache="$1"
    # The cache is an optimisation: when it cannot be written, the session is
    # still returned, and the next call asks STS again.
    if [ -n "$cache" ] && mkdir -p "$AWSV_RUN" 2>/dev/null && chmod 700 "$AWSV_RUN" 2>/dev/null; then
        printf '%s\n%s\n%s\n%s\n' "$SAKID" "$SSECRET" "$STOKEN" "$SEXP" > "$cache.tmp" 2>/dev/null \
            && mv -f "$cache.tmp" "$cache"
    fi
    return 0
}

# How long the MFA session of NAME has left, for status and ls. Only the expiry
# line of the cache is read; the keys in it are not.
mfa_left() {   # NAME
    local cache exp_s now left
    cache="$(cache_file "$1")"; now="$(date +%s)"
    if [ -z "$cache" ] || [ ! -f "$cache" ]; then
        printf '%s\n' "${Y}no MFA session${N} — awsv unlock $1 (it asks for the code)"; return 0
    fi
    exp_s="$(date -d "$(sed -n 4p "$cache")" +%s 2>/dev/null || echo 0)"
    left=$(( exp_s - now ))
    if [ "$left" -le 60 ]; then
        printf '%s\n' "${Y}MFA session ended${N} — awsv unlock $1"
    else
        printf '%s\n' "${G}MFA session${N} until $(date -d "@$exp_s" '+%H:%M %Z'), $(human "$left") left"
    fi
}

# A session made with an MFA code, for an account whose policy requires MFA.
# unlock calls it right after the passphrase; the session lasts as long as the
# unlock window (15 minutes at least, as STS requires), and creds hands it out.
mfa_session() {   # NAME SECONDS
    local name="$1" secs="$2" mfa code cache out errf region
    mfa="$(meta_get "$name" mfa)"; [ -n "$mfa" ] || return 0
    cache="$(cache_file "$name")"
    [ -n "$cache" ] || die "an MFA session needs the session cache: set AWSV_RUN to a private directory"
    [ "$secs" -ge 900 ] || secs=900
    read -rp "MFA code for $name (${mfa##*/}): " code
    [[ "$code" =~ ^[0-9]{6}$ ]] || die "the MFA code is six digits; to try again: awsv unlock $name"
    decrypt_key "$name"
    region="$(meta_get "$name" region)"
    errf="$(mktemp)"
    out="$(aws_with "$AKID" "$SECRET" "" sts get-session-token \
             --serial-number "$mfa" --token-code "$code" \
             --duration-seconds "$secs" --region "${region:-us-east-1}" \
             --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken,Expiration]' \
             --output text 2>"$errf")" \
        || { local e; e="$(grep -v '^$' "$errf" | tail -1)"; rm -f "$errf"
             die "STS refused the MFA session of '$name': $e"; }
    rm -f "$errf"
    read -r SAKID SSECRET STOKEN SEXP <<< "$out"
    [ -n "$STOKEN" ] || die "STS returned no session for '$name'"
    save_session "$cache"
    [ -f "$cache" ] || die "the MFA session of $name could not be written to $AWSV_RUN"
    ok "MFA session for $name until $(date -d "$SEXP" '+%H:%M %Z')"
}

# ------------------------------------------------------------ ~/.aws/config

outside_block() {   # the config file without the awsv block
    [ -f "$CONFIG" ] || return 0
    awk -v b="$BEGIN" -v e="$END" '$0==b {skip=1; next} $0==e {skip=0; next} !skip' "$CONFIG"
}

# A profile the user keeps outside the vault — an SSO profile, say — can be the
# [default] too. The active file then holds "@NAME", so it is never mistaken for
# an account of the vault, and [default] gets its keys from that profile through
# aws configure export-credentials. Only [profile NAME] sections of the config
# outside the awsv block qualify: a key in ~/.aws/credentials is what awsv moves
# into the vault, not something to hand on.
valid_profile() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "bad profile name '$1'"; }
external_profiles() {   # [profile NAME] outside the awsv block, one per line
    outside_block | sed -nE 's/^[[:space:]]*\[profile[[:space:]]+([^]]+)\].*/\1/p' \
        | sed 's/[[:space:]]*$//' | grep -vx default | sort -u
}
is_external() { external_profiles | grep -qxF -- "$1"; }
external_region() {   # the region line of [profile NAME] outside the block
    outside_block | awk -v p="$1" '
        /^[[:space:]]*\[/ { h = $0; gsub(/^[[:space:]]*\[profile[[:space:]]+|\][[:space:]]*$/, "", h); ins = (h == p); next }
        ins && /^[[:space:]]*region[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }'
}

conflicts() {   # names awsv generates that the rest of the file defines too
    local want=" default " f
    for f in "$KEYS"/*.gpg; do [ -e "$f" ] && want+="$(basename "$f" .gpg) "; done
    outside_block \
        | sed -nE 's/^[[:space:]]*\[(profile[[:space:]]+)?([^]]+)\].*/\2/p' \
        | while IFS= read -r s; do case "$want" in *" $s "*) printf '%s ' "$s";; esac; done
}

render_block() {
    local act f n
    act="$(active)"
    printf '%s\n' "$BEGIN"
    if [ -n "$act" ] && exists "$act"; then
        printf '[default]\nregion = %s\noutput = json\ncredential_process = %s creds %s\n\n' \
            "$(meta_get "$act" region)" "$BIN" "$act"
    elif [ "${act#@}" != "$act" ] && is_external "${act#@}"; then
        local reg; reg="$(external_region "${act#@}")"
        printf '[default]\n'
        [ -z "$reg" ] || printf 'region = %s\n' "$reg"
        printf 'output = json\ncredential_process = %s creds %s\n\n' "$BIN" "$act"
    else
        printf '# no active account — run: awsv use NAME\n\n'
    fi
    for f in "$KEYS"/*.gpg; do
        [ -e "$f" ] || continue
        n="$(basename "$f" .gpg)"
        printf '[profile %s]\nregion = %s\noutput = json\ncredential_process = %s creds %s\n\n' \
            "$n" "$(meta_get "$n" region)" "$BIN" "$n"
    done
    printf '%s\n' "$END"
}

check_config() {
    local c; c="$(conflicts)"
    [ -z "$c" ] && return 0
    # The file checked is $CONFIG — AWS_CONFIG_FILE when it is set — shown with ~
    # for $HOME, so the default reads ~/.aws/config, as the README quotes it.
    die "${CONFIG/#"$HOME"/\~} already defines [${c% }] outside the awsv block. For [default] run 'awsv init --take-default'; rename or remove any other by hand."
}

write_config() {
    check_config
    mkdir -p "$(dirname "$CONFIG")" "$BACKUP"
    if [ -f "$CONFIG" ]; then
        cp -p "$CONFIG" "$BACKUP/config.$(date +%s%N)"
        ls -1t "$BACKUP"/config.* 2>/dev/null | tail -n +11 | xargs -r rm -f
    fi
    {   # the user's part, trailing blank lines dropped, then one blank line and the block
        outside_block | awk 'NF {for (; n > 0; n--) print ""; print; next} {n++}'
        printf '\n'
        render_block
    } > "$CONFIG.tmp"
    mv -f "$CONFIG.tmp" "$CONFIG"
    chmod 600 "$CONFIG"
}

take_default() {   # comment out [default] and [profile default] outside the block
    [ -f "$CONFIG" ] || return 0
    mkdir -p "$BACKUP"
    cp -p "$CONFIG" "$BACKUP/config.$(date +%s%N)"
    awk -v b="$BEGIN" -v e="$END" '
        $0 == b {inb = 1} $0 == e {inb = 0; print; next}
        inb {print; next}
        /^[[:space:]]*#?[[:space:]]*\[/ {
            cur = ($0 ~ /^[[:space:]]*\[(profile[[:space:]]+)?default\]/)
        }
        cur && NF {print "# awsv: " $0; next}   # a blank line stays blank
        {print}' "$CONFIG" > "$CONFIG.tmp" && mv -f "$CONFIG.tmp" "$CONFIG"
}

# ------------------------------------------------------- ~/.aws/credentials

# Print AKID=… and SECRET=… for one section. An active [s] uses its active
# lines; a commented #[s] uses its commented lines.
read_section() {
    awk -v s="$1" '
        function hdr(line,   h) { h = line; sub(/^[[:space:]]*#?[[:space:]]*/, "", h); return h }
        /^[[:space:]]*#?[[:space:]]*\[/ {
            com = ($0 ~ /^[[:space:]]*#/)
            ins = (hdr($0) == "[" s "]")
            if (ins) found++
            next
        }
        ins {
            l = $0
            if (com) { if (l !~ /^[[:space:]]*#/) next; sub(/^[[:space:]]*#[[:space:]]*/, "", l) }
            else if (l ~ /^[[:space:]]*#/) next
            if (l !~ /=/) next
            k = l; sub(/[[:space:]]*=.*/, "", k); gsub(/[[:space:]]/, "", k)
            v = l; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
            if (k == "aws_access_key_id")     print "AKID=" v
            if (k == "aws_secret_access_key") print "SECRET=" v
            if (k == "aws_session_token")     print "TOKEN=1"
        }
        END { print "FOUND=" found+0 }' "$CREDS"
}

drop_section() {   # SECTION NAME — remove [s] or #[s]; first an encrypted backup, to NAME's lock
    local h f; h="$(home_of "$2")"; f="$(fpr "$h" "$(uid_of "$2")")"
    mkdir -p "$BACKUP"
    g "$h" --quiet --yes --trust-model always --encrypt --recipient "$f" \
        --output "$BACKUP/credentials.$(date +%s%N).gpg" "$CREDS" \
        || die "could not back up the credentials file; nothing was removed"
    awk -v s="$1" '
        /^[[:space:]]*#?[[:space:]]*\[/ {
            h = $0; sub(/^[[:space:]]*#?[[:space:]]*/, "", h); del = (h == "[" s "]")
        }
        !del' "$CREDS" > "$CREDS.tmp" && mv -f "$CREDS.tmp" "$CREDS"
    chmod 600 "$CREDS"
}

plain_sections() {   # names of the sections that still hold a key in plain text
    [ -f "$CREDS" ] || return 0
    awk '/^[[:space:]]*\[/ { s = $0; sub(/^[[:space:]]*\[/, "", s); sub(/\].*$/, "", s); next }
         /^[[:space:]]*#/ { next }
         /^[[:space:]]*aws_access_key_id[[:space:]]*=/ && s != "" { print s }' "$CREDS" | sort -u
}

# ------------------------------------------------------------- the commands

parse_opts() {   # sets REGION MODE LOCK VERIFY STDIN AS KEEP YES MFA from the remaining arguments
    REGION=""; MODE=""; LOCK=""; VERIFY=1; STDIN=0; AS=""; KEEP=0; YES=0; MFA=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --region)    REGION="${2:-}"; shift ;;
            --mode)      MODE="${2:-}"; shift ;;
            --lock)      LOCK="${2:-}"; shift ;;
            --mfa)       MFA="${2:-}"; shift ;;
            --no-verify) VERIFY=0 ;;
            --stdin)     STDIN=1 ;;
            --as)        AS="${2:-}"; shift ;;
            --keep)      KEEP=1 ;;
            --yes)       YES=1 ;;
            *)           die "unknown option '$1' (try --help)" ;;
        esac
        shift
    done
    [ -z "$REGION" ] || valid_region "$REGION"
    [ -z "$MODE" ] || valid_mode "$MODE"
    [ -z "$LOCK" ] || valid_lock "$LOCK"
    [ -z "$MFA" ] || valid_mfa "$MFA"
}

# An account with an MFA device: its keys reach aws only as a session made with
# an MFA code, which unlock asks for. Accounts without one are not touched.
valid_mfa() {
    [ "$1" = none ] || [[ "$1" =~ ^arn:aws(-[a-z]+)*:iam::[0-9]{12}:mfa/[A-Za-z0-9+=,.@_/-]+$ ]] \
        || die "bad MFA device '$1': give its ARN, arn:aws:iam::ACCOUNT:mfa/DEVICE (IAM, Security credentials), or none"
}

read_key() {   # sets AKID SECRET from the terminal or from stdin
    if [ "$STDIN" = 1 ]; then
        IFS= read -r AKID; IFS= read -r SECRET
    else
        need_tty "typing a key in"
        read -rp 'Access key id: ' AKID
        read -rsp 'Secret access key (hidden): ' SECRET; printf '\n'
    fi
    [[ "$AKID" =~ ^A[KS]IA[A-Z0-9]{12,}$ ]] || die "that does not look like an access key id"
    [ -n "$SECRET" ] || die "empty secret"
}

store() {   # NAME REGION MODE LOCK — AKID and SECRET are set
    local name="$1" region="$2" mode="$3" lock="$4" id=""
    if [ "$VERIFY" = 1 ]; then
        id="$(aws_with "$AKID" "$SECRET" "" sts get-caller-identity --region "$region" \
                --query '[Account,Arn]' --output text 2>&1)" \
            || die "AWS rejected the key: $(printf '%s' "$id" | grep -v '^$' | tail -1)"
    fi
    encrypt_key "$name" "$lock"
    : > "$META/$name" 2>/dev/null || { mkdir -p "$META"; : > "$META/$name"; }
    meta_set "$name" region "$region"
    meta_set "$name" mode "$mode"
    meta_set "$name" lock "$lock"
    [ -z "${MFA:-}" ] || [ "$MFA" = none ] || meta_set "$name" mfa "$MFA"
    meta_set "$name" added "$(date -Is)"
    if [ -n "$id" ]; then
        meta_set "$name" account "$(printf '%s' "$id" | awk '{print $1}')"
        meta_set "$name" arn "$(printf '%s' "$id" | awk '{print $2}')"
    fi
    [ -n "$(active)" ] || printf '%s\n' "$name" > "$AWSV_HOME/active"
    drop_cache "$name"
    write_config
    ok "stored $name — $mode mode, $region${id:+, $(meta_get "$name" arn)}"
    if [ "$lock" = own ]; then say "  locked by its own passphrase: open it with awsv unlock $name"
    else say "  locked by the shared passphrase, with: $(names shared | joined)"; fi
    [ "$(active)" = "$name" ] && say "  ${B}it is the [default] profile now${N}"
    [ "$mode" = session ] && warn "  session mode: an STS session made without MFA cannot call the IAM API. If a tool needs it: awsv set $name --mode direct"
    return 0
}

# Ask how new accounts are locked. Only on a first run in a terminal: a vault
# that exists keeps its choice, and 'awsv init --lock own' changes it.
ask_lock() {
    local a
    say "${B}How should the vault lock your accounts?${N}"
    say "  ${C}1${N}  one passphrase for every account  ${D}— type it once a day, every account opens${N}"
    say "  ${C}2${N}  a passphrase for each account     ${D}— each account opens and locks on its own${N}"
    say "  ${D}You can change it later for one account: awsv set NAME --lock own (or shared)${N}"
    read -rp "Choose 1 or 2 [1]: " a
    case "${a:-1}" in 1) LOCK=shared ;; 2) LOCK=own ;; *) die "answer 1 or 2" ;; esac
}

cmd_init() {
    local take=0 conf ttl
    LOCK=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --take-default) take=1 ;;
            --lock) LOCK="${2:-}"; shift; valid_lock "$LOCK" ;;
            *) die "unknown option '$1' (try --help)" ;;
        esac
        shift
    done
    if [ -z "$LOCK" ]; then
        if [ -f "$AWSV_HOME/lock" ] || [ -n "$(fpr)" ] || ! { [ -t 0 ] && [ -t 1 ]; }; then
            LOCK="$(default_lock)"
        else
            ask_lock
        fi
    fi
    mkdir -p "$KEYS" "$META" "$BACKUP"; chmod 700 "$AWSV_HOME"
    printf '%s\n' "$LOCK" > "$AWSV_HOME/lock"
    [ "$LOCK" = shared ] && make_shared_key
    conf="$(conf_of "")"
    if ! grep -q '^default-cache-ttl' "$conf" 2>/dev/null; then
        [ -f "$conf" ] && cp -p "$conf" "$BACKUP/gpg-agent.conf.$(date +%s)"
        {
            printf '# awsv: the passphrase is asked once and kept for 8 hours\n'
            printf 'default-cache-ttl 28800\nmax-cache-ttl 28800\n'
            printf 'pinentry-program /usr/bin/pinentry-curses\n'
        } >> "$conf"
        gpgconf --reload gpg-agent
    fi
    if ! grep -q 'GPG_TTY' "$HOME/.bashrc" 2>/dev/null; then
        [ -f "$HOME/.bashrc" ] && cp -p "$HOME/.bashrc" "$BACKUP/bashrc.$(date +%s)"
        printf '\n# awsv: lets gpg ask for the passphrase in this terminal\nexport GPG_TTY=$(tty)\n' \
            >> "$HOME/.bashrc"
        warn "added 'export GPG_TTY=\$(tty)' to ~/.bashrc — open a new terminal, or run that line once here"
    fi
    [ "$take" = 1 ] && take_default && warn "commented out [default] in ~/.aws/config (backup in $BACKUP)"
    ttl="$(agent_ttl "")"
    if [ "$LOCK" = own ]; then
        ok "ready: each new account gets a passphrase of its own; you choose it when you add the account: awsv add NAME"
    else
        ok "ready: one passphrase for every new account, GPG key $(fpr | tail -c 17)"
    fi
    say "  a passphrase stays in memory for $(human "${ttl:-28800}") after it is typed; choose another time: awsv unlock 30m"
}

cmd_add() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv add NAME [--region R] [--mode M] [--lock shared|own]"
    shift; valid_name "$name"; parse_opts "$@"
    exists "$name" && die "'$name' is in the vault already — to replace its key: awsv rekey $name"
    initialized || die "the vault is not set up yet — run 'awsv init' first"
    check_config
    choose_lock "$name"
    read_key
    store "$name" "${REGION:-us-east-1}" "${MODE:-session}" "$LOCK"
    warn_shared_lock "$name"
}

# No --lock on a vault whose default is the shared passphrase: a terminal gets
# the choice; a script gets the shared one. Either way a shared result is said
# in colour, since opening one of those accounts opens them all. add and
# import call both; LOCK comes from parse_opts.
choose_lock() {   # NAME — sets LOCK, LOCK_OTHERS, LOCK_WARN
    LOCK_OTHERS="$(names shared | joined)"; LOCK_WARN=0
    [ -z "$LOCK" ] || return 0
    LOCK="$(default_lock)"
    [ "$LOCK" = shared ] || return 0
    if [ "$STDIN" = 0 ] && [ -t 0 ] && [ -t 1 ]; then ask_add_lock "$1" "$LOCK_OTHERS"; fi
    [ "$LOCK" = shared ] && LOCK_WARN=1
    return 0
}
warn_shared_lock() {   # NAME
    [ "${LOCK_WARN:-0}" = 1 ] || return 0
    warn "  $1 opens with the shared passphrase${LOCK_OTHERS:+, the same as $LOCK_OTHERS}: unlocking one unlocks them all."
    warn "  For a passphrase of its own: awsv set $1 --lock own"
}

ask_add_lock() {   # NAME OTHERS — sets LOCK
    local a
    say "${B}Which passphrase locks $1?${N}"
    say "  ${C}1${N}  the shared one${2:+, the same as $2}  ${D}— nothing new to remember${N}"
    say "  ${C}2${N}  its own  ${D}— gpg asks for a new passphrase twice; $1 opens and locks apart${N}"
    read -rp "Choose 1 or 2 [1]: " a
    case "${a:-1}" in 1) LOCK=shared ;; 2) LOCK=own ;; *) die "answer 1 or 2" ;; esac
}

cmd_import() {
    local sec="${1:-}" name vals FOUND=0 TOKEN=""
    [ -n "$sec" ] || die "usage: awsv import SECTION [--as NAME] [--keep] [--region R] [--mode M] [--lock shared|own]"
    shift; parse_opts "$@"
    name="${AS:-$sec}"; valid_name "$name"
    [ -f "$CREDS" ] || die "no $CREDS"
    exists "$name" && die "'$name' is in the vault already"
    initialized || die "the vault is not set up yet — run 'awsv init' first"
    vals="$(read_section "$sec")"
    AKID="$(printf '%s\n' "$vals" | sed -n 's/^AKID=//p')"
    SECRET="$(printf '%s\n' "$vals" | sed -n 's/^SECRET=//p')"
    FOUND="$(printf '%s\n' "$vals" | sed -n 's/^FOUND=//p')"
    TOKEN="$(printf '%s\n' "$vals" | sed -n 's/^TOKEN=//p')"
    [ "$FOUND" -ge 1 ] || die "no section [$sec] in $CREDS, active or commented"
    [ "$FOUND" -le 1 ] || die "[$sec] is in $CREDS more than once; leave one and run again"
    [ -z "$TOKEN" ] || die "[$sec] holds a session token — that is a temporary key, nothing to vault"
    [ -n "$AKID" ] && [ -n "$SECRET" ] || die "[$sec] has no aws_access_key_id / aws_secret_access_key"
    # The check runs before the key is stored, so a failure leaves both files as they were.
    check_config
    choose_lock "$name"
    store "$name" "${REGION:-us-east-1}" "${MODE:-session}" "$LOCK"
    if [ "$KEEP" = 0 ]; then
        drop_section "$sec" "$name"
        ok "  removed [$sec] from $CREDS (encrypted backup in $BACKUP)"
    fi
    warn_shared_lock "$name"
}

cmd_ls() {
    local n act i w
    local -a rows=() lit=() width=()
    act="$(active)"
    # Rows first, widths after: each column is as wide as its longest value, so
    # the table stays narrow whatever the names and ARNs are.
    rows+=("NAME|DEFAULT|MODE|LOCK|SESSION|REGION|ACCOUNT|ARN"); lit+=(head)
    for n in $(names); do
        rows+=("$n|$([ "$n" = "$act" ] && echo '*')|$(if [ -n "$(meta_get "$n" mfa)" ]; then echo mfa; else meta_get "$n" mode; fi)|$(lock_of "$n")|$(ls_session "$n")|$(meta_get "$n" region)|$(meta_get "$n" account)|$(meta_get "$n" arn)")
        lit+=("$([ "$n" = "$act" ] && echo on)")
    done
    # Profiles kept outside the vault, which awsv use can make the [default].
    for n in $(external_profiles); do
        exists "$n" && continue   # a vault account of that name wins, and is listed above
        rows+=("$n|$([ "@$n" = "$act" ] && echo '*')|external|-|-|$(external_region "$n")|-|[profile $n] in $CONFIG")
        lit+=("$([ "@$n" = "$act" ] && echo on)")
    done
    local -a f
    for i in "${!rows[@]}"; do
        IFS='|' read -r -a f <<< "${rows[i]}"
        for w in 0 1 2 3 4 5 6; do
            f[w]="${f[w]:-}"   # read -a drops empty fields at the end of the row
            [ "${#f[w]}" -le "${width[w]:-0}" ] || width[w]="${#f[w]}"
        done
    done
    for i in "${!rows[@]}"; do
        IFS='|' read -r -a f <<< "${rows[i]}"
        # the whole row in one colour: escape codes inside a padded column break the alignment
        case "${lit[i]}" in head) printf '%s' "$B" ;; on) printf '%s' "$G$B" ;; esac
        for w in 0 1 2 3 4 5 6; do printf '%-*s  ' "${width[w]}" "${f[w]:-}"; done
        printf '%s%s\n' "${f[7]:-}" "$N"
    done
    [ "${#rows[@]}" -gt 1 ] || say "${D}(the vault is empty — awsv add NAME, or awsv import SECTION)${N}"
    return 0
}

# The SESSION column of ls: when the MFA session of an account ends.
ls_session() {   # NAME
    local cache exp_s left
    [ -n "$(meta_get "$1" mfa)" ] || { echo -; return 0; }
    cache="$(cache_file "$1")"
    [ -n "$cache" ] && [ -f "$cache" ] || { echo none; return 0; }
    exp_s="$(date -d "$(sed -n 4p "$cache")" +%s 2>/dev/null || echo 0)"
    left=$(( exp_s - $(date +%s) ))
    if [ "$left" -le 60 ]; then echo ended
    else echo "$(date -d "@$exp_s" '+%H:%M') ($(human "$left"))"; fi
}

cmd_use() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv use NAME"
    if exists "$name"; then
        printf '%s\n' "$name" > "$AWSV_HOME/active"
        write_config
        ok "[default] is $name now — $(meta_get "$name" arn)"
    elif is_external "$name"; then
        valid_profile "$name"
        printf '@%s\n' "$name" > "$AWSV_HOME/active"
        write_config
        ok "[default] is $name now — [profile $name] of $CONFIG, not an account of the vault"
        say "  plain aws gets its keys as: aws configure export-credentials --profile $name"
    else
        die "no account '$name' in the vault and no [profile $name] in $CONFIG — see 'awsv ls'"
    fi
}

# Delete the GPG home of an account that no longer has its own passphrase.
# Only a directory under $LOCKS named after a valid account name qualifies.
drop_home() {   # NAME
    local h="$LOCKS/$1"
    valid_name "$1"
    [ -d "$h" ] || return 0
    forget "$h"
    rm -r -f -- "$h"
}

# Moving an account to another lock re-encrypts its file: the old passphrase
# opens it, the new key takes it. An own key the account no longer uses is
# deleted with its GPG home.
relock() {   # NAME LOCK
    local name="$1" old
    old="$(lock_of "$name")"
    if [ "$2" = "$old" ]; then say "$name is on the $2 lock already"; return 0; fi
    [ -t 0 ] && { GPG_TTY="$(tty)"; export GPG_TTY; }
    if [ "$old" = own ]; then say "${B}Step 1 of 2:${N} type the passphrase of $name, if gpg asks."
    else say "${B}Step 1 of 2:${N} type the shared passphrase, if gpg asks. When it is in memory, gpg asks nothing."; fi
    decrypt_key "$name"
    [ "$2" = own ] && say "${B}Step 2 of 2:${N} choose the new passphrase of $name."
    # One commit point, the mv. Before it the meta says "swapping from $old"
    # and the old file is in place; lock_of reads that state off the disk.
    seal_key "$name" "$2"
    meta_set "$name" relock_from "$old"
    meta_set "$name" lock "$2"
    mv -f "$KEYS/$name.gpg.tmp" "$KEYS/$name.gpg"
    meta_del "$name" relock_from
    unset AKID SECRET
    [ "$old" = own ] && drop_home "$name"
    drop_cache "$name"
    if [ "$2" = own ]; then ok "$name has its own passphrase now — open it with: awsv unlock $name"
    else ok "$name is on the shared passphrase now, with: $(names shared | joined)"; fi
}

cmd_set() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv set NAME [--region R] [--mode M] [--lock shared|own]"
    shift; need "$name"; parse_opts "$@"
    [ -n "$REGION$MODE$LOCK$MFA" ] || die "nothing to change: give --region, --mode, --lock or --mfa"
    [ -z "$LOCK" ] || relock "$name" "$LOCK"
    [ -z "$REGION" ] || meta_set "$name" region "$REGION"
    [ -z "$MODE" ] || meta_set "$name" mode "$MODE"
    if [ "$MFA" = none ]; then meta_del "$name" mfa
    elif [ -n "$MFA" ]; then meta_set "$name" mfa "$MFA"; fi
    drop_cache "$name"
    write_config
    ok "$name: $(meta_get "$name" mode) mode, $(meta_get "$name" region), $(lock_of "$name") lock"
    if [ -n "$(meta_get "$name" mfa)" ]; then
        say "  MFA: $(meta_get "$name" mfa) — aws gets $name only as an MFA session"
        warn "  Start one with: awsv unlock $name — it asks for the code after the passphrase"
    elif [ "$MFA" = none ]; then say "  MFA: none — $name works as before"; fi
}

cmd_rekey() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv rekey NAME"
    shift; need "$name"; parse_opts "$@"
    read_key
    store "$name" "$(meta_get "$name" region)" "$(meta_get "$name" mode)" "$(lock_of "$name")"
    warn "  the old key is still valid in AWS until you deactivate it in IAM"
}

cmd_rm() {
    local name="${1:-}" a lock; [ -n "$name" ] || die "usage: awsv rm NAME [--yes]"
    shift; need "$name"; parse_opts "$@"
    # [default] changes only with the use command. Removing the account it points at
    # would leave plain aws and Terraform with no keys, so that is refused.
    [ "$(active)" = "$name" ] && die "$name is [default]: plain aws and Terraform use it. Switch [default] first: awsv use NAME (see awsv ls), then awsv rm $name"
    if [ "$YES" = 0 ]; then
        need_tty "a confirmation (or pass --yes)"
        read -rp "${R}${B}Delete $name${N} ($(meta_get "$name" arn)) from the vault? [y/N] " a
        [ "$a" = y ] || [ "$a" = Y ] || die "nothing deleted"
    fi
    lock="$(lock_of "$name")"
    rm -f "$KEYS/$name.gpg" "$META/$name"
    [ "$lock" = own ] && drop_home "$name"     # its own GPG key opens nothing else
    drop_cache "$name"
    write_config
    ok "removed $name"
    warn "  its key is still valid in AWS — deactivate it in IAM if it is no longer needed"
}

cmd_exec() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv exec NAME -- CMD [ARGS]"
    shift; need "$name"
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "usage: awsv exec NAME -- CMD [ARGS]"
    unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN
    if [ "$(meta_get "$name" mode)" = direct ] && [ -z "$(meta_get "$name" mfa)" ]; then
        decrypt_key "$name"
        export AWS_ACCESS_KEY_ID="$AKID" AWS_SECRET_ACCESS_KEY="$SECRET"
    else
        session_creds "$name"
        export AWS_ACCESS_KEY_ID="$SAKID" AWS_SECRET_ACCESS_KEY="$SSECRET" AWS_SESSION_TOKEN="$STOKEN"
    fi
    export AWS_REGION="${AWS_REGION:-$(meta_get "$name" region)}"
    exec "$@"
}

cmd_creds() {   # the credential_process entry point
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv creds NAME"
    if [ "${name#@}" != "$name" ]; then   # @PROFILE: the [default] taken from outside the vault
        name="${name#@}"; valid_profile "$name"
        is_external "$name" || die "no [profile $name] in $CONFIG outside the awsv block — pick another [default]: awsv use NAME"
        # A profile that hands its keys back to awsv would loop for ever.
        [ -z "${AWSV_IN_CREDS:-}" ] || die "[profile $name] leads back to awsv; it has to get its keys some other way"
        unset AWS_PROFILE AWS_DEFAULT_PROFILE
        AWSV_IN_CREDS=1 exec aws configure export-credentials --profile "$name" --format process
    fi
    need "$name"
    if [ "$(meta_get "$name" mode)" = direct ] && [ -z "$(meta_get "$name" mfa)" ]; then
        decrypt_key "$name"
        printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s"}\n' "$AKID" "$SECRET"
    else
        session_creds "$name"
        printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s","SessionToken":"%s","Expiration":"%s"}\n' \
            "$SAKID" "$SSECRET" "$STOKEN" "$SEXP"
    fi
}

# "30m", "8h", "1h30m" → seconds. Capped at 24 hours, so a typo such as 999h
# cannot leave the vault open for weeks.
parse_duration() {
    local h m t
    [[ "$1" =~ ^(([0-9]+)h)?(([0-9]+)m)?$ ]] && [ -n "$1" ] || return 1
    h="${BASH_REMATCH[2]:-0}"; m="${BASH_REMATCH[4]:-0}"
    t=$(( 10#$h * 3600 + 10#$m * 60 ))
    [ "$t" -ge 60 ] && [ "$t" -le 86400 ] || return 1
    printf '%s\n' "$t"
}

# How long gpg-agent keeps the passphrase. Both values the same: the window is
# fixed from the moment the passphrase is typed, however often it is used.
set_agent_ttl() {   # HOME SECONDS
    local conf k
    conf="$(conf_of "$1")"
    for k in default-cache-ttl max-cache-ttl; do
        if grep -q "^$k" "$conf" 2>/dev/null; then sed -i "s/^$k .*/$k $2/" "$conf"
        else printf '%s %s\n' "$k" "$2" >> "$conf"; fi
    done
}
agent_ttl() { sed -n 's/^max-cache-ttl[[:space:]]*//p' "$(conf_of "${1:-}")" 2>/dev/null | head -1; }

human() {   # seconds → "8h", "30m", "1h30m"
    local h=$(( $1 / 3600 )) m=$(( $1 % 3600 / 60 ))
    printf '%s%s\n' "$([ "$h" -gt 0 ] && printf '%dh' "$h")" "$([ "$m" -gt 0 ] && printf '%dm' "$m")"
}

# Open the lock of one account: the shared passphrase, or the account's own.
open_lock() {   # NAME SECONDS
    local h until
    h="$(home_of "$1")"
    set_agent_ttl "$h" "$2"
    forget "$h"                                   # forget the old window, read the new one
    if [ "$(lock_of "$1")" = own ]; then say "${B}The passphrase of $1:${N}"
    else say "${B}The shared passphrase:${N}"; fi
    g "$h" --quiet --decrypt "$KEYS/$1.gpg" >/dev/null || die "not unlocked: $1"
    until=$(( $(date +%s) + $2 ))
    printf '%s\n' "$until" > "$(until_of "$h")"
    ok "unlocked for $(human "$2"), until $(date -d "@$until" '+%H:%M %Z') — $(scope_of "$1")"
}

cmd_unlock() {   # [NAME | all] [DURATION], in either order
    local target="" dur="" a secs n shared_done=0
    for a in "$@"; do
        if [ -z "$target" ] && { [ "$a" = all ] || exists "$a"; }; then target="$a"
        elif [ -z "$dur" ]; then dur="$a"
        else die "usage: awsv unlock [NAME|all] [DURATION]"; fi
    done
    dur="${dur:-8h}"
    secs="$(parse_duration "$dur")" \
        || die "bad duration '$dur': use minutes and hours, such as 30m, 8h or 1h30m; at most 24h. An account name is also accepted — see awsv ls"
    [ -n "$(names)" ] || die "the vault is empty — nothing to unlock"
    if [ -z "$target" ]; then                    # the account plain "aws" uses
        target="$(active)"; exists "$target" || target="$(names | head -1)"
    fi
    need_tty "unlock"
    if [ "$target" = all ]; then                 # each passphrase once: the shared one, then every own one
        for n in $(names); do
            if [ "$(lock_of "$n")" = shared ]; then
                [ "$shared_done" = 1 ] && continue
                shared_done=1
            fi
            open_lock "$n" "$secs"
        done
    else
        open_lock "$target" "$secs"
    fi
    for n in $(names); do   # the accounts just opened that need an MFA session
        [ -n "$(meta_get "$n" mfa)" ] || continue
        if [ "$target" = all ] || [ "$n" = "$target" ] \
           || { [ "$(lock_of "$n")" = shared ] && [ "$(lock_of "$target")" = shared ]; }; then
            mfa_session "$n" "$secs"
        fi
    done
    say "  Until then every process of this user can read those keys without a question: awsv help show"
    say "  Close earlier: awsv lock closes everything, awsv lock NAME closes one passphrase"
}

cmd_lock() {   # [NAME]
    local n h
    if [ -n "${1:-}" ]; then
        need "$1"
        h="$(home_of "$1")"
        forget "$h"; rm -f "$(until_of "$h")"
        if [ "$(lock_of "$1")" = own ]; then drop_cache "$1"
        else for n in $(names shared); do drop_cache "$n"; done; fi
        ok "locked: $(scope_of "$1")"
        return 0
    fi
    forget ""; rm -f "$(until_of "")"
    for n in $(names own); do
        h="$(home_of "$n")"; forget "$h"; rm -f "$(until_of "$h")"
    done
    drop_cache
    ok "locked: every passphrase is forgotten and every cached session is deleted"
}

# Print a stored key. Only when both stdin and stdout are a terminal: a pipe, a
# script or an assistant's shell would keep the secret in a log or a transcript.
cmd_show() {
    local name="${1:-}"; [ -n "$name" ] || die "usage: awsv show NAME"
    need "$name"
    { [ -t 0 ] && [ -t 1 ]; } \
        || die "show prints a secret, so it runs only in a terminal — not in a pipe, a script or an assistant's shell"
    GPG_TTY="$(tty)"; export GPG_TTY
    decrypt_key "$name"
    warn "The secret key of $name. Clear the screen when you are done."
    say "aws_access_key_id     = $AKID"
    say "aws_secret_access_key = $SECRET"
}

# The passphrase protects a GPG key, not each file in keys/: changing it
# re-encrypts nothing, and every account on that key keeps working.
cmd_passwd() {   # [NAME]
    local name="${1:-}" h u f
    need_tty "changing the passphrase"
    if [ -n "$name" ]; then
        need "$name"; h="$(home_of "$name")"; u="$(uid_of "$name")"
    elif [ -n "$(fpr)" ]; then
        h=""; u="$GPG_UID"
    else
        die "every account has its own passphrase — name one: awsv passwd NAME"
    fi
    f="$(fpr "$h" "$u")"; [ -n "$f" ] || die "no GPG key yet — run 'awsv init' first"
    if [ -n "$h" ]; then say "This changes the passphrase of ${B}$name${N} only."
    else say "This changes the shared passphrase, for: ${B}$(names shared | joined)${N}"; fi
    say "gpg asks for the current passphrase, then for the new one twice."
    g "$h" --change-passphrase "$f" || die "the passphrase was not changed"
    forget "$h"
    ok "passphrase changed — the next use asks for the new one"
}

lock_state() {   # HOME UID — sets LST (UNLOCKED or LOCKED) and LTXT, the coloured state
    local u now t
    now="$(date +%s)"
    u="$(cat "$(until_of "$1")" 2>/dev/null || echo 0)"
    if cached "$1" "$2"; then
        LST=UNLOCKED
        if [ "$u" -gt "$now" ]; then
            LTXT="${G}${B}UNLOCKED${N} until $(date -d "@$u" '+%H:%M %Z'), ${YG}${YG:+ }$(( (u - now) / 60 )) min left${YG:+ }${N}"
        else
            t="$(agent_ttl "$1")"
            LTXT="${G}${B}UNLOCKED${N} for up to $(human "${t:-28800}") from when the passphrase was typed"
        fi
    else
        LST=LOCKED; LTXT="${Y}${B}LOCKED${N}"
    fi
}

# One block for the vault, then one block per account, all in the same shape.
# Every line says what it means, not only a value.
cmd_status() {
    local act n mode exp_s left now cache acct arn plain line shared first h
    act="$(active)"; now="$(date +%s)"
    shared="$(names shared | joined)"

    say "${B}VAULT${N}       $AWSV_HOME"
    # The state first and on its own line: open or closed is the one thing to
    # see at a glance. What it means goes on the line below.
    if ! initialized; then
        say "  state     ${Y}${B}NOT SET UP${N}"
        say "            there is no GPG key yet — create it: awsv init"
    else
        if [ "$(default_lock)" = own ]; then
            say "  new       a new account gets a passphrase of its own   ${D}— switch: awsv init --lock shared${N}"
        else
            say "  new       a new account gets the shared passphrase   ${D}— switch: awsv init --lock own${N}"
        fi
        if [ -n "$shared" ]; then
            first="$(names shared | head -1)"
            { [ -n "$act" ] && [ "$(lock_of "$act")" = shared ] && exists "$act"; } && first="$act"
            lock_state "" "$GPG_UID"
            say "  state     $LTXT   ${D}(the shared passphrase)${N}"
            if [ "$LST" = UNLOCKED ]; then
                say "            any process of this user can read the keys of $shared now — close it: awsv lock"
            else
                say "            the next aws command asks for the passphrase — open it: awsv unlock $first 30m"
            fi
            say "  GPG key   $(fpr | tail -c 17) in ~/.gnupg — the shared passphrase, for: $shared. Change it: awsv passwd"
        elif [ -n "$(fpr)" ]; then
            say "  shared    GPG key $(fpr | tail -c 17) in ~/.gnupg — no account uses the shared passphrase now"
        fi
        if [ -n "$(names own)" ]; then
            say "  own       $(names own | joined) — each has a passphrase of its own; its state is in its block below"
        fi
    fi
    if [ -n "$AWSV_RUN" ]; then
        say "  sessions  $AWSV_RUN — one-hour sessions, in memory; a reboot deletes them"
    else
        say "  sessions  ${Y}not cached${N} — no private tmpfs, so every call asks AWS STS"
    fi
    plain="$(plain_sections | tr '\n' ' ')"; plain="${plain% }"
    if [ -n "$plain" ]; then
        say "  ${R}${B}WARNING${N}   ${R}$CREDS still holds a key for: $plain${N}"
        say "            A key there wins over the vault. Move it: awsv import NAME"
    else
        say "  plain     ${G}no keys left${N} in $CREDS — correct: the keys are in the vault"
    fi

    local count=0 list=()
    [ -n "$act" ] && exists "$act" && list+=("$act")      # [default] first
    for n in $(names); do [ "$n" = "$act" ] || list+=("$n"); done
    count="${#list[@]}"
    say ""
    say "${B}ACCOUNTS${N}    $count   ${D}* marks [default]: the account that plain \"aws\" uses${N}"
    say "            ${D}LOCKED or UNLOCKED: the state of the passphrase that opens the account${N}"
    if [ "${act#@}" != "$act" ]; then   # [default] is a profile outside the vault
        n="${act#@}"
        say ""
        if is_external "$n"; then
            say "${G}${B}* $n${N}  ${G}[default]${N}  ${BY}EXTERNAL${N}"
            say "    source    [profile $n] in $CONFIG — outside the vault, awsv keeps no key for it"
            say "    keys      aws configure export-credentials --profile $n   ${D}— an SSO profile needs aws sso login when its login expires${N}"
            say "    region    $(external_region "$n")"
        else
            say "${R}${B}* $n${N}  ${R}[default]  MISSING${N}"
            say "    source    no [profile $n] in $CONFIG any more — plain aws fails"
        fi
        say "    try       ${C}aws sts get-caller-identity${N}   ${D}— plain aws uses this profile; a vault account again: awsv use NAME${N}"
    fi
    for n in "${list[@]}"; do
        mode="$(meta_get "$n" mode)"; acct="$(meta_get "$n" account)"; arn="$(meta_get "$n" arn)"
        h="$(home_of "$n")"
        lock_state "$h" "$(uid_of "$n")"
        say ""
        if [ "$n" = "$act" ]; then
            say "${G}${B}* $n${N}  ${G}[default]${N}  ${BY}ACTIVE:$LST${N}"
        else
            say "  ${B}$n${N}  ${BC}NOT ACTIVE:$LST${N}"
        fi
        if [ -n "$h" ]; then
            say "    lock      own passphrase — opens $n only. Change it: awsv passwd $n"
            if [ "$LST" = UNLOCKED ]; then line="close it: awsv lock $n"; else line="open it: awsv unlock $n 30m"; fi
        else
            say "    lock      shared passphrase — the same for: $shared"
            if [ "$LST" = UNLOCKED ]; then line="close it: awsv lock $n — closes every shared account"
            else line="open it: awsv unlock $n 30m — opens every shared account"; fi
        fi
        say "    state     $LTXT   ${D}$line${N}"
        say "    account   ${acct:-not checked — stored with --no-verify}"
        say "    user      ${arn:-not checked}"
        say "    region    $(meta_get "$n" region)"
        if [ -n "$(meta_get "$n" mfa)" ]; then
            say "    mode      mfa — tools get a session made with an MFA code ($(meta_get "$n" mfa))"
            say "    session   $(mfa_left "$n")"
        elif [ "$mode" = direct ]; then
            say "    mode      direct — tools get the stored key itself"
            say "    session   none — direct mode does not use sessions"
        else
            say "    mode      session — tools get a one-hour session, never the key"
            cache="$(cache_file "$n")"
            if [ -z "$AWSV_RUN" ]; then
                line="not cached — every call asks AWS STS for a new one"
            elif [ -n "$cache" ] && [ -f "$cache" ]; then
                exp_s="$(date -d "$(sed -n 4p "$cache")" +%s 2>/dev/null || echo 0)"
                left=$(( (exp_s - now) / 60 ))
                if [ "$left" -gt 0 ]; then
                    line="${G}valid${N} until $(date -d "@$exp_s" '+%H:%M %Z'), $left min left"
                else
                    line="expired — the next call gets a new one"
                fi
            else
                line="none yet — the next aws call gets one"
            fi
            say "    session   $line"
        fi
        if [ -n "$h" ]; then
            say "    key file  $KEYS/$n.gpg — its GPG key is in $h"
        else
            say "    key file  $KEYS/$n.gpg"
        fi
        if [ "$n" = "$act" ]; then
            say "    try       ${C}aws sts get-caller-identity${N}   ${D}— plain aws uses this account${N}"
        else
            say "    try       ${C}aws --profile $n sts get-caller-identity${N}   ${D}— or make it [default]: awsv use $n${N}"
        fi
    done
    [ "$count" -gt 0 ] || say "  ${D}(none yet — awsv add NAME, or awsv import SECTION)${N}"
    return 0
}

# ------------------------------------------------------------------- main

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
    init)   cmd_init "$@" ;;
    add)    cmd_add "$@" ;;
    import) cmd_import "$@" ;;
    ls|list) cmd_ls ;;
    use)    cmd_use "$@" ;;
    set)    cmd_set "$@" ;;
    rekey)  cmd_rekey "$@" ;;
    rm|remove) cmd_rm "$@" ;;
    exec)   cmd_exec "$@" ;;
    creds)  cmd_creds "$@" ;;
    unlock) cmd_unlock "$@" ;;
    show)   cmd_show "$@" ;;
    passwd) cmd_passwd "$@" ;;
    lock)   cmd_lock "$@" ;;
    status) cmd_status ;;
    ""|-h|--help|help) cmd_help "$@" ;;
    *)      die "unknown command '$cmd' (try --help)" ;;
esac
